<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@android:color/white"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/textCartItemName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Menu item"
        android:textColor="#222222"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textCartItemDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="35000 VND × 1 = 35000 VND"
        android:textColor="#6F3E25" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/buttonChangeQuantity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sửa số lượng" />

        <Button
            android:id="@+id/buttonRemoveCartItem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Xóa" />
    </LinearLayout>
</LinearLayout>

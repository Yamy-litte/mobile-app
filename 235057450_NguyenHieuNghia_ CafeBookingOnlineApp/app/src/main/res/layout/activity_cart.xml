<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cartRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F3EF"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Giỏ hàng của bạn"
        android:textColor="#6F3E25"
        android:textSize="24sp"
        android:textStyle="bold" />

    <ListView
        android:id="@+id/listCartItems"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:divider="@android:color/transparent"
        android:dividerHeight="8dp" />

    <TextView
        android:id="@+id/textCartEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="20dp"
        android:text="Giỏ hàng đang trống."
        android:textColor="#666666"
        android:visibility="gone" />

    <TextView
        android:id="@+id/textCartTotal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:text="Tổng tiền: 0 VND"
        android:textColor="#6F3E25"
        android:textSize="18sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/buttonCheckout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Thanh toán / Checkout" />

    <Button
        android:id="@+id/buttonContinueShopping"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tiếp tục chọn món" />
</LinearLayout>

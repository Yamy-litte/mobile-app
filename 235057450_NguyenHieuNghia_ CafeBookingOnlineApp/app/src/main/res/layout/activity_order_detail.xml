<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F3EF"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Chi tiết đơn hàng"
        android:textColor="#6F3E25"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textOrderInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="#FFFFFF"
        android:padding="14dp"
        android:text="Đang tải..."
        android:textColor="#444444"
        android:textSize="15sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="6dp"
        android:text="Các món đã đặt"
        android:textColor="#6F3E25"
        android:textSize="18sp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/layoutOrderLines"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:orientation="vertical" />
    </ScrollView>

    <Button
        android:id="@+id/buttonReviewOrder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Đánh giá đơn hàng"
        android:visibility="gone" />

    <Button
        android:id="@+id/buttonCancelOrder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Hủy đơn hàng"
        android:visibility="gone" />

    <Button
        android:id="@+id/buttonOrderDetailBack"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Quay lại lịch sử đơn hàng" />
</LinearLayout>
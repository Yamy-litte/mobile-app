<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FFF9F4">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Café Booking Online"
            android:textColor="#5D4037"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tạo tài khoản khách hàng"
            android:textColor="#795548"
            android:textSize="18sp"
            android:gravity="center"
            android:layout_marginBottom="28dp" />

        <EditText
            android:id="@+id/editRegisterEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Địa chỉ email"
            android:inputType="textEmailAddress"
            android:autofillHints="emailAddress"
            android:singleLine="true"
            android:padding="14dp"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/editRegisterPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Mật khẩu (ít nhất 6 ký tự)"
            android:inputType="textPassword"
            android:autofillHints="newPassword"
            android:singleLine="true"
            android:padding="14dp"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/editRegisterConfirmPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Xác nhận mật khẩu"
            android:inputType="textPassword"
            android:autofillHints="newPassword"
            android:singleLine="true"
            android:padding="14dp"
            android:layout_marginBottom="20dp" />

        <Button
            android:id="@+id/buttonCreateAccount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Đăng ký"
            android:textAllCaps="false"
            android:padding="12dp" />

        <Button
            android:id="@+id/buttonBackToLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Đã có tài khoản? Đăng nhập"
            android:textAllCaps="false"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/textRegisterStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#5D4037"
            android:textSize="14sp"
            android:paddingTop="16dp"
            android:accessibilityLiveRegion="polite" />
    </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:padding="12dp"
    android:orientation="vertical"
    android:background="@drawable/bg_admin_screen_readonly">
    <TextView
        android:id="@+id/counterOnlineBookTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"/>
    <TextView
        android:id="@+id/counterOnlineBookDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textSize="13sp"
        android:textColor="@color/text_secondary"/>
    <TextView
        android:id="@+id/counterOnlineBookStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textSize="13sp"
        android:textColor="@color/text_secondary"/>
    <Button
        android:id="@+id/counterOnlineSelect"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:backgroundTint="@color/library_blue"
        android:textColor="@color/surface"
        android:textAllCaps="false"
        android:text="Chọn yêu cầu này" />
</LinearLayout>

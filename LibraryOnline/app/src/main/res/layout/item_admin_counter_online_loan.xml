<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:padding="14dp"
    android:orientation="vertical"
    android:background="@drawable/bg_circulation_selected_card"
    android:clickable="true"
    android:focusable="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView android:id="@+id/counterOnlineBookTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:maxLines="2"
            android:ellipsize="end" />
        <TextView android:id="@+id/counterOnlineStage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:paddingStart="9dp"
            android:paddingEnd="9dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:background="@drawable/bg_admin_soft"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/library_blue"
            android:text="CHỜ GIAO" />
    </LinearLayout>
    <TextView android:id="@+id/counterOnlineBookDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textSize="13sp"
        android:lineSpacingExtra="2dp"
        android:textColor="@color/text_secondary"/>
    <TextView android:id="@+id/counterOnlineBookStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:textSize="13sp"
        android:textColor="@color/text_primary"/>
    <Button android:id="@+id/counterOnlineSelect"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:backgroundTint="@color/library_blue"
        android:textColor="@color/surface"
        android:textAllCaps="false"
        android:textSize="13sp"
        android:text="Chọn yêu cầu này"/>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="88dp"
    android:layout_marginBottom="12dp"
    android:padding="16dp"
    android:orientation="vertical"
    android:background="@drawable/bg_reader_book_card"
    android:foreground="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">
    <TextView
        android:id="@+id/inventoryBookTitle"
        style="@style/CatalogueBody"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/inventoryBookMeta"
        style="@style/CatalogueCaption"
        android:layout_marginTop="6dp" />
    <TextView
        android:id="@+id/inventoryBookCount"
        style="@style/CatalogueBody"
        android:textColor="@color/library_blue"
        android:layout_marginTop="8dp" />
</LinearLayout>

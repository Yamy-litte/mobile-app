<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="15dp" android:layout_marginTop="10dp" android:background="@drawable/bg_admin_screen_card"><TextView android:id="@+id/adminReportHeading" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="5dp" android:paddingBottom="5dp" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold" android:text="Tiền phạt đã thu" /><TextView android:id="@+id/adminReportCollected" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="5dp" android:paddingBottom="5dp" android:textColor="@color/library_blue" android:textSize="29sp" android:textStyle="bold" android:text="—"/><TextView android:id="@+id/adminReportTransactions" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="5dp" android:paddingBottom="5dp" android:textColor="@color/text_secondary" android:textSize="13sp" android:text="Đang tải số giao dịch..." /><TextView android:id="@+id/adminReportDebtTotal" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="5dp" android:paddingBottom="5dp" android:textColor="@color/text_primary" android:textSize="14sp" android:textStyle="bold" android:text="Nợ chờ thu: —" /></LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="15dp" android:layout_marginTop="10dp" android:background="@drawable/bg_admin_screen_card"><TextView android:id="@+id/adminReportTrendHeading" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="5dp" android:paddingBottom="5dp" android:textColor="@color/text_primary" android:textSize="17sp" android:textStyle="bold" android:text="Đã thu trong 7 ngày gần nhất" /><LinearLayout android:id="@+id/adminReportBars" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="bottom" android:orientation="horizontal" android:layout_marginTop="8dp"/></LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="15dp" android:layout_marginTop="10dp" android:background="@drawable/bg_admin_screen_card"><TextView android:id="@+id/adminReportRecentHeading" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="5dp" android:paddingBottom="5dp" android:textColor="@color/text_primary" android:textSize="17sp" android:textStyle="bold" android:text="Khoản đã thu" /><TextView android:id="@+id/adminReportRecent" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="5dp" android:paddingBottom="5dp" android:textColor="@color/text_secondary" android:textSize="13sp" android:text="Đang tải..." android:lineSpacingExtra="5dp"/></LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="15dp" android:layout_marginTop="10dp" android:background="@drawable/bg_admin_screen_card"><TextView android:id="@+id/adminReportUnpaidHeading" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="5dp" android:paddingBottom="5dp" android:textColor="@color/text_primary" android:textSize="17sp" android:textStyle="bold" android:text="Nợ trễ hạn chờ thu" /><TextView android:id="@+id/adminReportUnpaid" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="5dp" android:paddingBottom="5dp" android:textColor="@color/text_secondary" android:textSize="13sp" android:text="Đang tải..." android:lineSpacingExtra="5dp"/></LinearLayout>
<Button android:id="@+id/adminReportRefresh" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:backgroundTint="@color/library_blue" android:textColor="@color/white" android:textAllCaps="false" android:text="Làm mới báo cáo" /></LinearLayout>

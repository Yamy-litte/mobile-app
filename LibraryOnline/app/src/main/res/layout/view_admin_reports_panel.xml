<TextView android:id="@+id/adminReportStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="5dp" android:paddingBottom="5dp" android:textColor="@color/text_secondary" android:textSize="13sp" android:text="Đang tải các khoản thu trên thiết bị..." android:background="@drawable/bg_admin_screen_readonly" android:padding="12dp"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal" android:background="@drawable/bg_admin_screen_readonly">
<Button android:id="@+id/adminReportPeriod0" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:backgroundTint="@color/library_filter_background" android:textColor="@color/library_filter_text" android:text="Ngày" android:textAllCaps="false" android:textSize="12sp"/><Button android:id="@+id/adminReportPeriod1" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:backgroundTint="@color/library_filter_background" android:textColor="@color/library_filter_text" android:text="Tuần" android:textAllCaps="false" android:textSize="12sp"/><Button android:id="@+id/adminReportPeriod2" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:backgroundTint="@color/library_filter_background" android:textColor="@color/library_filter_text" android:text="Tháng" android:textAllCaps="false" android:textSize="12sp"/>

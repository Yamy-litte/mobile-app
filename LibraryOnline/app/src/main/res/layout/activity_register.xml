<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ĐĂNG KÝ THẺ THƯ VIỆN"
            android:textSize="24sp"
            android:textStyle="bold"
            android:paddingBottom="8dp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nhập thông tin chính xác. Email và số điện thoại cần được xác minh trước khi yêu cầu được duyệt."
            android:textSize="14sp"
            android:paddingBottom="18dp" />
        <EditText
            android:id="@+id/editFullName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Họ và tên"
            android:inputType="textPersonName"
            android:autofillHints="name"
            android:singleLine="true" />
        <EditText
            android:id="@+id/editRegisterEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Email"
            android:inputType="textEmailAddress"
            android:autofillHints="emailAddress"
            android:singleLine="true"
            android:layout_marginTop="12dp" />
        <EditText
            android:id="@+id/editPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Số điện thoại Việt Nam"
            android:inputType="phone"
            android:autofillHints="phone"
            android:singleLine="true"
            android:layout_marginTop="12dp" />
        <Button
            android:id="@+id/buttonSubmitRegistration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Gửi yêu cầu đăng ký"
            android:layout_marginTop="20dp" />
    </LinearLayout>
</ScrollView>

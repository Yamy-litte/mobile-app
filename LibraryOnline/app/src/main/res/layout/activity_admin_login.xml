<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/library_background"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="32dp"
        android:paddingEnd="24dp"
        android:paddingBottom="28dp">
        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginBottom="8dp"
            android:contentDescription="Logo MyLibrary"
            android:src="@drawable/mylibrary_logo"
            android:scaleType="fitCenter" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MyLibrary"
            android:textColor="@color/library_blue"
            android:textSize="30sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="KHU VỰC QUẢN TRỊ"
            android:textColor="@color/library_muted"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@drawable/bg_auth_card"
            android:elevation="2dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Đăng nhập Admin"
                android:textColor="@color/library_navy"
                android:textSize="24sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="20dp"
                android:text="Chỉ tài khoản đã được cấp quyền trong hồ sơ Admin mới có thể truy cập."
                android:textColor="@color/library_muted"
                android:textSize="14sp" />
            <EditText
                android:id="@+id/editAdminEmail"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_auth_input"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:hint="Email quản trị viên"
                android:inputType="textEmailAddress"
                android:autofillHints="emailAddress"
                android:singleLine="true"
                android:textColor="@color/library_text"
                android:textColorHint="@color/library_muted" />
            <EditText
                android:id="@+id/editAdminPassword"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_auth_input"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
            android:drawableEnd="@drawable/ic_visibility_off"
            android:drawablePadding="8dp"
                android:hint="Mật khẩu"
                android:inputType="textPassword" android:saveEnabled="false"
                android:autofillHints="password"
                android:singleLine="true"
                android:textColor="@color/library_text"
                android:textColorHint="@color/library_muted" />

            <CheckBox
                android:id="@+id/checkAdminLogin"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:buttonTint="@color/library_blue"
                android:buttonTintMode="src_in"
                android:paddingEnd="4dp"
                android:text="Ghi nhớ đăng nhập"
                android:textColor="@color/library_muted"
                android:textSize="13sp" />
            <Button
                android:id="@+id/buttonAdminLogin"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="18dp"
                android:backgroundTint="@color/library_blue"
                android:text="Đăng nhập Admin"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/textBackToReaderLogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:padding="10dp"
                android:text="Quay lại đăng nhập độc giả"
                android:textColor="@color/library_blue"
                android:textSize="14sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="10dp" android:padding="15dp"
    android:orientation="vertical" android:background="@drawable/bg_admin_screen_card">
    <TextView android:id="@+id/readerOnlineReceiptTitle"
        style="@style/ReaderLoansHeading" android:textSize="15sp"/>
    <TextView android:id="@+id/readerOnlineReceiptCopy"
        style="@style/ReaderLoansCaption" android:layout_marginTop="7dp"/>
    <TextView android:id="@+id/readerOnlineReceiptDates"
        style="@style/ReaderLoansCaption" android:layout_marginTop="6dp"/>
    <TextView android:id="@+id/readerOnlineReceiptStatus"
        style="@style/ReaderLoansCaption" android:layout_marginTop="8dp"
        android:textStyle="bold" android:textColor="@color/library_success"/>
</LinearLayout>
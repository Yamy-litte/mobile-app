<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/readerAccount"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="gone"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">
        <TextView
            style="@style/CatalogueHeading"
            android:text="@string/nav_reader_account" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@drawable/bg_admin_card">
            <TextView
                android:id="@+id/readerAccountName"
                style="@style/CatalogueHeading" />
            <TextView
                android:id="@+id/readerAccountEmail"
                style="@style/CatalogueBody" />
            <TextView
                android:id="@+id/readerAccountBarcode"
                style="@style/CatalogueBody"
                android:layout_marginTop="20dp" />
            <TextView
                android:id="@+id/readerAccountStatus"
                style="@style/CatalogueBody"
                android:layout_marginTop="12dp" />
        </LinearLayout>
        <Button
            android:id="@+id/readerAccountLogout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/admin_logout"
            android:textColor="@color/library_logout"
            style="?attr/borderlessButtonStyle" />
    </LinearLayout>
</ScrollView>

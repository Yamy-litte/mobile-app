<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/readerAccount"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:background="@color/library_background"
    android:visibility="gone">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <!-- Reader account overview. Keep all actions in XML and data bindings in Java. -->
        <LinearLayout
            android:id="@+id/readerAccountOverview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="32dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <ImageView
                    android:id="@+id/readerAccountBack"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:padding="12dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_inventory_back"
                    android:contentDescription="Quay về trang chủ" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Tài khoản độc giả"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/library_navy" />
            </LinearLayout>
            <TextView
                android:id="@+id/readerAccountAvatar"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="30dp"
                android:background="@drawable/bg_reader_avatar"
                android:gravity="center"
                android:text="TV"
                android:textColor="@color/library_navy"
                android:textSize="23sp"
                android:textStyle="bold"
                android:contentDescription="Ảnh đại diện độc giả" />
            <TextView
                android:id="@+id/readerAccountName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:text="Độc giả"
                android:textColor="@color/library_navy"
                android:textSize="21sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/readerAccountContactSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:gravity="center"
                android:text="Đang tải thông tin liên hệ..."
                android:textColor="@color/library_muted"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/readerAccountLoadStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:padding="6dp"
                android:text="Đang tải hồ sơ..."
                android:textColor="@color/library_muted"
                android:textSize="12sp" />
            <!-- Hidden compatibility bindings for the existing SessionProfile/ReaderHomeView. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
                <TextView android:id="@+id/readerAccountStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
                <TextView android:id="@+id/readerAccountBarcode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
                <TextView android:id="@+id/readerAccountExpiry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="18dp"
                android:background="@color/library_border" />
        <LinearLayout
            android:id="@+id/readerAccountPersonal"
            style="@style/ReaderAccountActionRow"
            android:contentDescription="Thông tin cá nhân">
            <ImageView
                style="@style/ReaderAccountActionIcon"
                android:src="@drawable/ic_admin_account"
                android:contentDescription="@null" />
            <TextView
                style="@style/ReaderAccountActionLabel"
                android:text="Thông tin cá nhân" />
            <TextView
                style="@style/ReaderAccountActionChevron"
                android:text="›" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/readerAccountChangePassword"
            style="@style/ReaderAccountActionRow"
            android:contentDescription="Đổi mật khẩu">
            <ImageView
                style="@style/ReaderAccountActionIcon"
                android:src="@drawable/ic_reader_lock"
                android:contentDescription="@null" />
            <TextView
                style="@style/ReaderAccountActionLabel"
                android:text="Đổi mật khẩu" />
            <TextView
                style="@style/ReaderAccountActionChevron"
                android:text="›" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/readerAccountDigitalCard"
            style="@style/ReaderAccountActionRow"
            android:contentDescription="Thẻ thư viện số">
            <ImageView
                style="@style/ReaderAccountActionIcon"
                android:src="@drawable/ic_reader_card"
                android:contentDescription="@null" />
            <TextView
                style="@style/ReaderAccountActionLabel"
                android:text="Thẻ thư viện số" />
            <TextView
                style="@style/ReaderAccountActionChevron"
                android:text="›" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/readerAccountNotificationsSettings"
            style="@style/ReaderAccountActionRow"
            android:contentDescription="Cài đặt thông báo">
            <ImageView
                style="@style/ReaderAccountActionIcon"
                android:src="@drawable/ic_nav_bell"
                android:contentDescription="@null" />
            <TextView
                style="@style/ReaderAccountActionLabel"
                android:text="Cài đặt thông báo" />
            <TextView
                style="@style/ReaderAccountActionChevron"
                android:text="›" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/readerAccountAbout"
            style="@style/ReaderAccountActionRow"
            android:contentDescription="Về MyLibrary">
            <ImageView
                style="@style/ReaderAccountActionIcon"
                android:src="@drawable/ic_reader_info"
                android:contentDescription="@null" />
            <TextView
                style="@style/ReaderAccountActionLabel"
                android:text="Về MyLibrary" />
            <TextView
                style="@style/ReaderAccountActionChevron"
                android:text="›" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/readerAccountLogout"
            style="@style/ReaderAccountActionRow"
            android:contentDescription="Đăng xuất">
            <ImageView
                style="@style/ReaderAccountActionIcon"
                android:src="@drawable/ic_reader_logout"
                android:contentDescription="@null" />
            <TextView
                style="@style/ReaderAccountActionLabel"
                android:text="Đăng xuất"
                android:textColor="@color/library_logout" />
            
        </LinearLayout>
        </LinearLayout>
        <!-- Editor matches Figma: immutable member identity, editable contact fields. -->
        <LinearLayout
            android:id="@+id/readerAccountEditor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="30dp"
            android:visibility="gone">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <ImageView
                    android:id="@+id/readerAccountProfileBack"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:padding="12dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_inventory_back"
                    android:contentDescription="Quay lại tài khoản" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Chỉnh sửa hồ sơ"
                    android:textColor="@color/library_navy"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_admin_card"
                android:orientation="vertical"
                android:padding="16dp">
                        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Thông tin hồ sơ"
            android:textColor="@color/library_text"
            android:textSize="16sp"
            android:textStyle="bold" />
            <TextView
                style="@style/ReaderAccountFieldLabel"
                android:text="Họ tên · Không chỉnh sửa" />
                <TextView
                    android:id="@+id/readerAccountFullName"
                    style="@style/ReaderAccountReadOnlyField"
                    android:text="Đang tải..." />
            <TextView
                style="@style/ReaderAccountFieldLabel"
                android:text="Ngày sinh · Không chỉnh sửa" />
                <TextView
                    android:id="@+id/readerAccountBirthDate"
                    style="@style/ReaderAccountReadOnlyField"
                    android:text="Đang tải..." />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_admin_card"
                android:orientation="vertical"
                android:padding="16dp">
                        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Thông tin liên hệ"
            android:textColor="@color/library_text"
            android:textSize="16sp"
            android:textStyle="bold" />
            <TextView
                style="@style/ReaderAccountFieldLabel"
                android:text="Email" />
            <EditText
                android:id="@+id/readerAccountEmailInput"
                style="@style/ReaderAccountInput"
                android:hint="name@example.com"
                android:inputType="textEmailAddress"
                android:autofillHints="emailAddress"
                android:singleLine="true" />
            <TextView
                style="@style/ReaderAccountFieldLabel"
                android:text="Số điện thoại" />
            <EditText
                android:id="@+id/readerAccountPhoneInput"
                style="@style/ReaderAccountInput"
                android:hint="Nhập số điện thoại"
                android:inputType="phone"
                android:autofillHints="phone"
                android:singleLine="true" />
            </LinearLayout>
            <Button
                android:id="@+id/readerAccountSave"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="14dp"
                android:backgroundTint="@color/library_blue"
                android:text="Lưu thông tin liên hệ"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="8dp"
                android:text="Các tùy chọn khác"
                android:textColor="@color/library_muted"
                android:textSize="13sp" />
        <LinearLayout
            android:id="@+id/readerAccountEditPassword"
            style="@style/ReaderAccountActionRow"
            android:contentDescription="Đổi mật khẩu">
            <ImageView
                style="@style/ReaderAccountActionIcon"
                android:src="@drawable/ic_reader_lock"
                android:contentDescription="@null" />
            <TextView
                style="@style/ReaderAccountActionLabel"
                android:text="Đổi mật khẩu" />
            <TextView
                style="@style/ReaderAccountActionChevron"
                android:text="›" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/readerAccountEditCard"
            style="@style/ReaderAccountActionRow"
            android:contentDescription="Thẻ thư viện số">
            <ImageView
                style="@style/ReaderAccountActionIcon"
                android:src="@drawable/ic_reader_card"
                android:contentDescription="@null" />
            <TextView
                style="@style/ReaderAccountActionLabel"
                android:text="Thẻ thư viện số" />
            <TextView
                style="@style/ReaderAccountActionChevron"
                android:text="›" />
        </LinearLayout>
        </LinearLayout>
        <include layout="@layout/view_reader_password_change" />
        <include layout="@layout/view_reader_digital_card" />
    </LinearLayout>
</ScrollView>

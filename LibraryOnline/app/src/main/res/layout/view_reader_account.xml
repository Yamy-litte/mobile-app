<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/readerAccount"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="gone"
    android:fillViewport="true"
    android:background="@color/library_background">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">
        <TextView
            style="@style/CatalogueHeading"
            android:text="Tài khoản của tôi"
            android:textSize="24sp" />
        <TextView
            style="@style/CatalogueBody"
            android:layout_marginTop="5dp"
            android:text="Quản lý hồ sơ, thẻ thư viện và bảo mật tài khoản." />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@drawable/bg_admin_card">
            <TextView
                android:id="@+id/readerAccountName"
                style="@style/CatalogueHeading"
                android:text="Độc giả"
                android:textSize="20sp" />
            <TextView
                android:id="@+id/readerAccountStatus"
                style="@style/CatalogueBody"
                android:layout_marginTop="8dp"
                android:text="Trạng thái thẻ" />
            <TextView
                android:id="@+id/readerAccountBarcode"
                style="@style/CatalogueBody"
                android:layout_marginTop="6dp"
                android:text="Mã thẻ" />
            <TextView
                android:id="@+id/readerAccountExpiry"
                style="@style/CatalogueBody"
                android:layout_marginTop="6dp"
                android:text="Hạn dùng" />
        </LinearLayout>
        <TextView
            style="@style/CatalogueHeading"
            android:layout_marginTop="24dp"
            android:text="Thông tin liên hệ"
            android:textSize="18sp" />
        <TextView
            style="@style/CatalogueBody"
            android:layout_marginTop="5dp"
            android:text="Họ tên và ngày sinh được quản lý theo hồ sơ đã duyệt." />
        <TextView
            style="@style/CatalogueBody"
            android:layout_marginTop="14dp"
            android:text="Email" />
        <EditText
            android:id="@+id/readerAccountEmailInput"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="5dp"
            android:background="@drawable/bg_reader_search"
            android:hint="name@example.com"
            android:inputType="textEmailAddress"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:singleLine="true"
            android:autofillHints="emailAddress" />
        <TextView
            style="@style/CatalogueBody"
            android:layout_marginTop="12dp"
            android:text="Số điện thoại" />
        <EditText
            android:id="@+id/readerAccountPhoneInput"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="5dp"
            android:background="@drawable/bg_reader_search"
            android:hint="Nhập số điện thoại"
            android:inputType="phone"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:singleLine="true"
            android:autofillHints="phone" />
        <Button
            android:id="@+id/readerAccountSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Lưu thông tin liên hệ" />
        <TextView
            style="@style/CatalogueHeading"
            android:layout_marginTop="24dp"
            android:text="Bảo mật và tiện ích"
            android:textSize="18sp" />
        <Button
            android:id="@+id/readerAccountDigitalCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Xem thẻ thư viện số" />
        <Button
            android:id="@+id/readerAccountChangePassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Đổi mật khẩu" />
        <Button
            android:id="@+id/readerAccountLogout"
            style="?attr/borderlessButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/admin_logout"
            android:textColor="@color/library_logout" />
    </LinearLayout>
</ScrollView>

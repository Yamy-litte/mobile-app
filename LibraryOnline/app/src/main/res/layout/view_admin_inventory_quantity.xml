<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">
    <TextView
        style="@style/InventoryCaption"
        android:text="@string/inventory_ui_quantity"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/intakeMinus"
            style="@style/InventoryHalf"
            android:text="@string/inventory_ui_minus"
            android:layout_width="48dp"
            android:layout_weight="0"/>
        <EditText
            android:id="@+id/intakeQuantity"
            style="@style/InventoryInput"
            android:hint="@string/inventory_ui_quantity"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:inputType="number"
            android:gravity="center"
            android:text="1"
            android:maxLength="1"
            android:layout_marginBottom="0dp"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/intakePlus"
            style="@style/InventoryHalf"
            android:text="@string/inventory_ui_plus"
            android:layout_width="48dp"
            android:layout_weight="0"/>
    </LinearLayout>
    <TextView
        style="@style/InventoryCaption"
        android:text="@string/inventory_ui_shelf"
        android:layout_marginTop="12dp"/>
    <EditText
        android:id="@+id/intakeShelf"
        style="@style/InventoryInput"
        android:hint="@string/inventory_ui_shelf_hint"/>
</LinearLayout>

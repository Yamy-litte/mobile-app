<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
<TextView android:id="@+id/adminConfigSource" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="5dp" android:paddingBottom="5dp" android:textColor="@color/text_secondary" android:textSize="13sp" android:text="Đang kiểm tra cấu hình Firestore..." android:background="@drawable/bg_admin_screen_readonly" android:padding="12dp"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="15dp" android:layout_marginTop="10dp" android:background="@drawable/bg_admin_screen_card">
<TextView android:id="@+id/adminConfigHeading" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="5dp" android:paddingBottom="5dp" android:textColor="@color/text_primary" android:textSize="19sp" android:textStyle="bold" android:text="Hạn mức mượn" />

<TextView android:id="@+id/adminConfigBooksLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="5dp" android:paddingBottom="5dp" android:textColor="@color/text_primary" android:textSize="14sp" android:textStyle="bold" android:text="Số cuốn tối đa / độc giả" />
<LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal" android:gravity="center_vertical">
<Button android:id="@+id/adminConfigBooksMinus" android:layout_width="46dp" android:layout_height="48dp" android:text="−" android:textAllCaps="false" android:backgroundTint="@color/library_blue" android:textColor="@color/white"/>
<EditText android:id="@+id/adminConfigBooksInput" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:inputType="number" android:gravity="center" android:singleLine="true" android:background="@drawable/bg_admin_screen_field" android:textColor="@color/text_primary"/>
<Button android:id="@+id/adminConfigBooksPlus" android:layout_width="46dp" android:layout_height="48dp" android:text="+" android:textAllCaps="false" android:backgroundTint="@color/library_blue" android:textColor="@color/white"/>
</LinearLayout>

<TextView android:id="@+id/adminConfigDaysLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="5dp" android:paddingBottom="5dp" android:textColor="@color/text_primary" android:textSize="14sp" android:textStyle="bold" android:text="Số ngày mượn tối đa" />
<LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal" android:gravity="center_vertical">
<Button android:id="@+id/adminConfigDaysMinus" android:layout_width="46dp" android:layout_height="48dp" android:text="−" android:textAllCaps="false" android:backgroundTint="@color/library_blue" android:textColor="@color/white"/>
<EditText android:id="@+id/adminConfigDaysInput" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:inputType="number" android:gravity="center" android:singleLine="true" android:background="@drawable/bg_admin_screen_field" android:textColor="@color/text_primary"/>
<Button android:id="@+id/adminConfigDaysPlus" android:layout_width="46dp" android:layout_height="48dp" android:text="+" android:textAllCaps="false" android:backgroundTint="@color/library_blue" android:textColor="@color/white"/>
</LinearLayout>
<TextView android:id="@+id/adminConfigHelp" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="5dp" android:paddingBottom="5dp" android:textColor="@color/text_secondary" android:textSize="12sp" android:text="Tính cả sách đang mượn và yêu cầu Online chờ lấy. Tổng không được vượt hạn mức." /></LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="15dp" android:layout_marginTop="10dp" android:background="@drawable/bg_admin_screen_card">
<TextView android:id="@+id/adminConfigFixedHeading" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="5dp" android:paddingBottom="5dp" android:textColor="@color/text_primary" android:textSize="18sp" android:textStyle="bold" android:text="Quy tắc cố định · Chỉ đọc" />
<TextView android:id="@+id/adminConfigOnlineHold" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="5dp" android:paddingBottom="5dp" android:textColor="@color/text_secondary" android:textSize="14sp" /><TextView android:id="@+id/adminConfigReserve" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" android:textColor="@color/text_secondary"/>
<TextView android:id="@+id/adminConfigMultiplier" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" android:textColor="@color/text_secondary"/>
<TextView android:id="@+id/adminConfigLateFee" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="5dp" android:paddingBottom="5dp" android:textColor="@color/text_secondary" android:textSize="14sp" /></LinearLayout>
<Button android:id="@+id/adminConfigSave" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:backgroundTint="@color/library_blue" android:textColor="@color/white" android:textAllCaps="false" android:text="Lưu cấu hình" />
<TextView android:id="@+id/adminConfigNotice" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="5dp" android:paddingBottom="5dp" android:textColor="@color/text_secondary" android:textSize="12sp" android:text="Giới hạn mới chỉ có hiệu lực sau khi Firestore xác nhận lưu." /></LinearLayout>

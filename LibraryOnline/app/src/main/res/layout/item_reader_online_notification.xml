<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="14dp" android:paddingBottom="14dp" android:orientation="vertical" android:background="@drawable/bg_reader_search">
<TextView android:id="@+id/readerOnlineNotTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingBottom="6dp" android:textSize="16sp" android:textColor="@color/text_primary" android:textStyle="bold"/>
<TextView android:id="@+id/readerOnlineNotMessage" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingBottom="6dp" android:textSize="13sp" android:textColor="@color/text_secondary"/>
<TextView android:id="@+id/readerOnlineNotDate" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingBottom="6dp" android:textSize="13sp" android:textColor="@color/text_secondary"/>
<TextView android:id="@+id/readerOnlineNotRead" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingBottom="6dp" android:textSize="16sp" android:textColor="@color/library_blue" android:textStyle="bold" android:visibility="gone" android:text="Đánh dấu đã đọc"/>
<TextView android:id="@+id/readerOnlineNotDone" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingBottom="6dp" android:textSize="13sp" android:textColor="@color/text_secondary" android:visibility="gone" android:text="Đã đọc"/></LinearLayout>

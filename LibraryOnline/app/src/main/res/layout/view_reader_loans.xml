<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/readerLoans"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true"
    android:visibility="gone">
    <LinearLayout android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="22dp"
        android:paddingBottom="28dp">
        <TextView
            style="@style/ReaderLoansHeading"
            android:text="Sách của tôi"
            android:textSize="23sp"/>
        <TextView
            style="@style/ReaderLoansCaption"
            android:layout_marginTop="6dp"
            android:text="Theo dõi sách đang mượn, yêu cầu mượn và các lượt đã trả." />

        <HorizontalScrollView android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:clipToPadding="false"
            android:scrollbars="none"
            android:fillViewport="false">
            <LinearLayout android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <Button android:id="@+id/readerLoansTabBorrowed"
                    style="@style/ReaderLoansTab" android:text="Đang mượn"
                    android:contentDescription="Hiển thị sách đã nhận, chưa trả"/>
                <Button android:id="@+id/readerLoansTabPickup"
                    style="@style/ReaderLoansTab" android:layout_marginStart="8dp"
                    android:text="Chờ lấy"
                    android:contentDescription="Hiển thị yêu cầu đã duyệt, đang chờ nhận sách"/>
                <Button android:id="@+id/readerLoansTabPending"
                    style="@style/ReaderLoansTab" android:layout_marginStart="8dp"
                    android:text="Chờ duyệt"
                    android:contentDescription="Hiển thị yêu cầu đang chờ thủ thư xét duyệt"/>
                <Button android:id="@+id/readerLoansTabHistory"
                    style="@style/ReaderLoansTab" android:layout_marginStart="8dp"
                    android:text="Đã trả"
                    android:contentDescription="Hiển thị các cuốn sách đã hoàn trả"/>
            </LinearLayout>
        </HorizontalScrollView>

        <TextView
            style="@style/ReaderLoansCaption"
            android:layout_marginTop="8dp"
            android:textSize="12sp"
            android:text="Đang mượn và Đã trả gồm cả sách mượn tại quầy có trên thiết bị và sách được giao qua yêu cầu Online." />

        <LinearLayout android:id="@+id/readerLoansOnlineSection"
            style="@style/ReaderLoansSection">
            <TextView android:id="@+id/readerLoansSectionHeading"
                style="@style/ReaderLoansHeading"
                android:text="Sách đang mượn"/>
            <TextView android:id="@+id/readerLoansSectionDescription"
                style="@style/ReaderLoansCaption"
                android:layout_marginTop="5dp"
                android:text="Tất cả sách đã giao và chưa trả, không phân biệt hình thức mượn."/>
            <TextView android:id="@+id/textReaderOnlineSummary"
                style="@style/ReaderLoansCaption"
                android:layout_marginTop="10dp"
                android:text="@string/online_borrow_loading"
                android:accessibilityLiveRegion="polite"/>
            <LinearLayout android:id="@+id/containerReaderOnlineRequests"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"/>
            <!-- Local and Online loan cards share one section without source subheadings. -->
            <LinearLayout android:id="@+id/readerLoansLocalPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView android:id="@+id/textReaderLoansSummary"
                    style="@style/ReaderLoansCaption"
                    android:visibility="gone"
                    android:text="Đang tải phiếu mượn..."/>
                <LinearLayout android:id="@+id/containerReaderLoans"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:id="@+id/readerLoansHistoryPanel"
            style="@style/ReaderLoansSection"
            android:visibility="gone">
            <TextView style="@style/ReaderLoansHeading"
                android:text="Sách đã trả"/>
            <TextView style="@style/ReaderLoansCaption"
                android:layout_marginTop="5dp"
                android:text="Các cuốn đã được thư viện xác nhận nhận trả, không phân biệt cách mượn."/>
            <TextView android:id="@+id/textReaderOnlineReceiptsSummary"
                style="@style/ReaderLoansCaption"
                android:layout_marginTop="9dp"
                android:text="Đang tải sách đã trả…"
                android:accessibilityLiveRegion="polite"/>
            <LinearLayout android:id="@+id/containerReaderOnlineReceipts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"/>
            <LinearLayout android:id="@+id/containerReaderReturnedLoans"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>

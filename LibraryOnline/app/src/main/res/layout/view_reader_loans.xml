<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/readerLoans"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:visibility="gone">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">
        <TextView style="@style/CatalogueHeading"
            android:text="@string/online_borrow_reader_heading" />
        <TextView android:id="@+id/textReaderOnlineSummary"
            style="@style/CatalogueBody" android:layout_marginTop="6dp"
            android:text="@string/online_borrow_loading"/>
        <LinearLayout android:id="@+id/containerReaderOnlineRequests"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:layout_marginBottom="20dp"
            android:orientation="vertical"/>
        <TextView style="@style/CatalogueHeading"
            android:text="Lịch sử giao sách Online" />
        <TextView android:id="@+id/textReaderOnlineReceiptsSummary"
            style="@style/CatalogueCaption"
            android:layout_marginTop="6dp"
            android:text="Đang tải lịch sử nhận sách…" />
        <LinearLayout android:id="@+id/containerReaderOnlineReceipts"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:layout_marginBottom="20dp"
            android:orientation="vertical"/>
        <TextView
            style="@style/CatalogueHeading"
            android:text="Sách đang mượn (dữ liệu trên thiết bị)" />
        <TextView
            android:id="@+id/textReaderLoansSummary"
            style="@style/CatalogueBody"
            android:layout_marginTop="6dp"
            android:text="Đang tải phiếu mượn..." />
        <LinearLayout
            android:id="@+id/containerReaderLoans"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/library_background"
    android:id="@+id/readerRoot">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <ScrollView
            android:id="@+id/readerScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:clipToPadding="false">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="16dp"
                android:paddingEnd="20dp"
                android:paddingBottom="18dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="MY LIBRARY"
                            android:textColor="@color/library_navy"
                            android:textSize="11sp"
                            android:letterSpacing="0.12"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/textReaderGreeting"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Minh Đông"
                            android:textColor="@color/library_text"
                            android:textSize="25sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/buttonReaderAccount"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_reader_avatar"
                        android:gravity="center"
                        android:text="MD"
                        android:textColor="@color/library_navy"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:contentDescription="Tài khoản độc giả" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_reader_search"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">
                    <TextView
                        android:layout_width="24dp"
                        android:layout_height="wrap_content"
                        android:text="⌕"
                        android:textColor="@color/library_muted"
                        android:textSize="24sp" />
                    <EditText
                        android:id="@+id/inputBookSearch"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:hint="Tìm tên sách, tác giả..."
                        android:imeOptions="actionSearch"
                        android:singleLine="true"
                        android:textColor="@color/library_text"
                        android:textColorHint="@color/library_muted"
                        android:textSize="14sp"
                        android:paddingStart="8dp"
                        android:paddingEnd="0dp" />
                    <Button
                        android:id="@+id/readerScanBookBarcode"
                        android:layout_width="54dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="4dp"
                        android:text="Quét"
                        android:contentDescription="Quét barcode tìm sách"
                        android:textSize="12sp"
                        android:textAllCaps="false"
                        android:backgroundTint="@color/library_blue"
                        android:textColor="@color/surface" />

                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Danh mục"
                        android:textColor="@color/library_text"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Xem tất cả"
                        android:textColor="@color/library_blue"
                        android:textSize="12sp" />
                </LinearLayout>
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="10dp"
                    android:fillViewport="false"
                    android:scrollbars="none">
                    <LinearLayout
                        android:id="@+id/containerReaderCategories"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal" />
                </HorizontalScrollView>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Sách phổ biến"
                        android:textColor="@color/library_text"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/textPopularCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Đang tải..."
                        android:textColor="@color/library_muted"
                        android:textSize="12sp" />
                </LinearLayout>
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:clipToPadding="false"
                    android:scrollbars="none">
                    <LinearLayout
                        android:id="@+id/containerPopularBooks"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Sách mới cập nhật"
                        android:textColor="@color/library_text"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mới nhất"
                        android:textColor="@color/library_blue"
                        android:textSize="12sp" />
                </LinearLayout>
                <TextView
                    android:id="@+id/textReaderCatalogueStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Danh sách sách trong thư viện"
                    android:textColor="@color/library_muted"
                    android:textSize="12sp" />
                <LinearLayout
                    android:id="@+id/containerLatestBooks"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>
        <include layout="@layout/view_reader_loans" />
        <include layout="@layout/view_reader_notifications" />
        <include layout="@layout/view_reader_account" />
    </FrameLayout>
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/library_border" />
    <include layout="@layout/view_reader_bottom_navigation" />
</LinearLayout>

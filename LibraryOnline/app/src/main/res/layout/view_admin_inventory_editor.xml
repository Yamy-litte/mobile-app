<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">
    <include
        android:id="@+id/editorSummary"
        layout="@layout/view_admin_inventory_book_summary"/>
    <LinearLayout
        style="@style/InventoryCard"
        android:orientation="vertical"
        android:id="@+id/editorIdentity">
        <TextView
            style="@style/InventorySection"
            android:text="@string/inventory_ui_identity"/>
        <TextView
            android:id="@+id/editorBookId"
            style="@style/InventoryCaption"/>
    </LinearLayout>
    <LinearLayout
        style="@style/InventoryCard"
        android:orientation="vertical">
        <TextView
            style="@style/InventorySection"
            android:text="@string/inventory_ui_metadata"/>
        <TextView
            style="@style/InventoryCaption"
            android:text="@string/inventory_ui_title"/>
        <EditText
            android:id="@+id/formTitle"
            style="@style/InventoryInput"
            android:hint="@string/inventory_ui_title"
            android:maxLength="300"/>
        <TextView
            style="@style/InventoryCaption"
            android:text="@string/inventory_ui_author"/>
        <EditText
            android:id="@+id/formAuthor"
            style="@style/InventoryInput"
            android:hint="@string/inventory_ui_author"
            android:maxLength="200"/>
        <TextView
            style="@style/InventoryCaption"
            android:text="@string/inventory_ui_category"/>
        <Spinner
            android:id="@+id/formCategory"
            style="@style/InventoryInput"
            android:contentDescription="@string/book_category_label"/>
        <TextView
            style="@style/InventoryCaption"
            android:text="@string/inventory_ui_publisher"/>
        <EditText
            android:id="@+id/formPublisher"
            style="@style/InventoryInput"
            android:hint="@string/inventory_ui_publisher"
            android:maxLength="200"/>
        <TextView
            style="@style/InventoryCaption"
            android:text="@string/inventory_ui_year"/>
        <EditText
            android:id="@+id/formYear"
            style="@style/InventoryInput"
            android:hint="@string/inventory_ui_year"
            android:inputType="number"
            android:maxLength="4"/>
        <TextView
            style="@style/InventoryCaption"
            android:text="@string/inventory_ui_isbn"/>
        <EditText
            android:id="@+id/formIsbn"
            style="@style/InventoryInput"
            android:hint="@string/inventory_ui_isbn"
            android:inputType="text"/>
        <TextView
            style="@style/InventoryCaption"
            android:text="@string/inventory_ui_cover"/>
        <EditText
            android:id="@+id/formCover"
            style="@style/InventoryInput"
            android:hint="@string/inventory_ui_cover"
            android:inputType="textUri"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/editorCoverPreview"
            style="@style/InventoryOutline"
            android:text="@string/inventory_ui_preview"/>
        <TextView
            style="@style/InventoryCaption"
            android:text="@string/inventory_ui_description"/>
        <EditText
            android:id="@+id/formDescription"
            style="@style/InventoryInput"
            android:hint="@string/inventory_ui_description"
            android:inputType="textMultiLine"
            android:singleLine="false"
            android:minLines="4"
            android:gravity="top"/>
    </LinearLayout>
    <LinearLayout
        style="@style/InventoryCard"
        android:orientation="vertical"
        android:id="@+id/editorInitialStock">
        <TextView
            style="@style/InventorySection"
            android:text="@string/inventory_ui_initial"/>
        <include layout="@layout/view_admin_inventory_quantity"/>
    </LinearLayout>
    <TextView
        style="@style/InventoryCaption"
        android:text="@string/inventory_ui_automatic"/>
    <TextView
        android:id="@+id/editorError"
        style="@style/InventoryError"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/editorSave"
        style="@style/InventoryPrimary"
        android:text="@string/inventory_ui_save_create"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/editorManageCopies"
        style="@style/InventoryOutline"
        android:text="@string/inventory_ui_manage_copies"/>
</LinearLayout>

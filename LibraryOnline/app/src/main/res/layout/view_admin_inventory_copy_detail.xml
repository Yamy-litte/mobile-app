<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">
    <include layout="@layout/view_admin_inventory_book_summary"/>
    <LinearLayout
        style="@style/InventoryCard"
        android:orientation="vertical">
        <TextView
            android:id="@+id/copyState"
            style="@style/InventoryText"
            android:textColor="@color/library_success"/>
        <TextView
            style="@style/InventoryCaption"
            android:text="@string/inventory_ui_title_id"/>
        <TextView
            android:id="@+id/copyTitleId"
            style="@style/InventoryText"/>
        <TextView
            style="@style/InventoryCaption"
            android:text="@string/inventory_ui_copy_id"/>
        <TextView
            android:id="@+id/copyIdentity"
            style="@style/InventoryCaption"/>
        <ImageView
            android:id="@+id/copyBarcodeImage"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:adjustViewBounds="true"
            android:contentDescription="@string/stock_barcode"/>
        <TextView
            android:id="@+id/copyBarcodeText"
            style="@style/InventoryCaption"
            android:gravity="center"/>
        <TextView
            style="@style/InventoryCaption"
            android:text="@string/inventory_ui_shelf"/>
        <EditText
            android:id="@+id/copyShelfInput"
            style="@style/InventoryInput"
            android:hint="@string/inventory_ui_shelf_hint"/>
        <TextView
            android:id="@+id/copyError"
            style="@style/InventoryError"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/copySaveShelf"
            style="@style/InventoryPrimary"
            android:text="@string/inventory_ui_save_shelf"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/copyPrint"
            style="@style/InventoryOutline"
            android:text="@string/inventory_ui_print_single"/>
    </LinearLayout>
    <LinearLayout
        style="@style/InventoryCard"
        android:orientation="vertical">
        <TextView
            style="@style/InventorySection"
            android:text="@string/inventory_ui_history"/>
        <TextView
            style="@style/InventoryCaption"
            android:text="@string/inventory_ui_history_pending"/>
    </LinearLayout>
    <LinearLayout
        style="@style/InventoryCard"
        android:orientation="vertical">
        <TextView
            style="@style/InventorySection"
            android:text="@string/inventory_ui_hide_heading"/>
        <TextView
            style="@style/InventoryCaption"
            android:text="@string/inventory_ui_retire_rule"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/copyHide"
            style="@style/InventoryOutline"
            android:text="@string/inventory_ui_hide_copy"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/copyRetire"
            style="@style/InventoryOutline"
            android:text="@string/inventory_ui_retire_copy"
            android:textColor="@color/library_danger"/>
        <TextView
            android:id="@+id/copyRestoreHint"
            style="@style/InventoryCaption"
            android:visibility="gone" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/copyRestore"
            style="@style/InventoryOutline"
            android:text="@string/inventory_ui_restore_copy"
            android:textColor="@color/library_success"
            android:visibility="gone"/>
    </LinearLayout>
</LinearLayout>

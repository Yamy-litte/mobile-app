<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/library_background"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">
        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginBottom="12dp"
            android:contentDescription="Logo MyLibrary"
            android:src="@drawable/mylibrary_logo"
            android:scaleType="fitCenter" />
        <TextView
            android:id="@+id/textChangePasswordTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Đổi mật khẩu lần đầu"
            android:textColor="@color/library_navy"
            android:textSize="26sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/textChangePasswordDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="20dp"
            android:text="Để bảo vệ tài khoản, bạn cần tạo mật khẩu mới trước khi sử dụng thư viện."
            android:textColor="@color/library_muted"
            android:textSize="14sp" />
        <EditText
            android:id="@+id/editNewPassword"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_auth_input"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:drawableEnd="@drawable/ic_visibility_off"
            android:drawablePadding="8dp"
            android:hint="Mật khẩu mới (ít nhất 8 ký tự)"
            android:inputType="textPassword"
            android:saveEnabled="false"
            android:singleLine="true"
            android:textColor="@color/library_text"
            android:textColorHint="@color/library_muted" />
        <EditText
            android:id="@+id/editConfirmPassword"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_auth_input"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:drawableEnd="@drawable/ic_visibility_off"
            android:drawablePadding="8dp"
            android:hint="Nhập lại mật khẩu mới"
            android:inputType="textPassword"
            android:saveEnabled="false"
            android:singleLine="true"
            android:textColor="@color/library_text"
            android:textColorHint="@color/library_muted" />
        <Button
            android:id="@+id/buttonChangePassword"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:backgroundTint="@color/library_blue"
            android:text="Đổi mật khẩu"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/adminManagementRoot"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
        android:paddingStart="10dp" android:paddingEnd="18dp"
        android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:id="@+id/adminManagementBack" android:layout_width="48dp"
            android:layout_height="48dp" android:src="@drawable/ic_inventory_back"
            android:padding="12dp" android:tint="@color/admin_screen_primary"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Quay lại tab Quản lý" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:gravity="end"
            android:text="MY LIBRARY · QUẢN TRỊ" android:textColor="@color/admin_screen_muted"
            android:textSize="12sp" />
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:fillViewport="true" android:clipToPadding="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp"
            android:paddingBottom="28dp">
            <TextView android:id="@+id/adminManagementTitle"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:fontFamily="serif" android:textStyle="bold"
                android:textColor="@color/admin_screen_ink" android:textSize="24sp"
                android:text="Quản lý thư viện" />
            <TextView android:id="@+id/adminManagementSubtitle"
                style="@style/AdminScreenCaption" android:layout_marginTop="5dp"
                android:layout_marginBottom="14dp" />
            <LinearLayout android:id="@+id/adminManagementContent"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
    <include layout="@layout/view_admin_bottom_navigation" />
</LinearLayout>
<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/readerNotifications"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:visibility="gone">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">
        <TextView style="@style/CatalogueHeading"
            android:text="@string/online_borrow_notifications"/>
        <TextView android:id="@+id/textReaderOnlineNotificationsSummary"
            style="@style/CatalogueBody" android:layout_marginTop="6dp"
            android:text="@string/online_borrow_loading"/>
        <LinearLayout android:id="@+id/containerReaderOnlineNotifications"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:layout_marginBottom="20dp"
            android:orientation="vertical"/>
        <TextView style="@style/CatalogueHeading"
            android:text="@string/online_borrow_local_notifications"/>

        <TextView
            android:id="@+id/textReaderNotificationsSummary"
            style="@style/CatalogueBody"
            android:layout_marginTop="6dp"
            android:text="Đang tải thông báo..." />
        <LinearLayout
            android:id="@+id/containerReaderNotifications"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:id="@+id/inventoryRoot"
    android:background="@color/library_background">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <ImageButton
            android:id="@+id/inventoryBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_inventory_back"
            android:contentDescription="@string/catalogue_back"/>
        <TextView
            android:id="@+id/inventoryHeading"
            style="@style/InventorySection"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_marginBottom="0dp"
            android:text="@string/inventory_title"/>
        <ImageButton
            android:id="@+id/inventoryRefresh"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_admin_refresh"
            android:contentDescription="@string/catalogue_refresh"/>
    </LinearLayout>
    <TextView
        android:id="@+id/inventoryStatus"
        style="@style/InventoryCaption"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:accessibilityLiveRegion="polite"
        android:text="@string/catalogue_loading"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/inventoryRetry"
        style="@style/InventoryOutline"
        android:text="@string/inventory_ui_resume"
        android:visibility="gone"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <ScrollView
            android:id="@+id/inventoryScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="12dp"
                android:paddingBottom="84dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:id="@+id/inventoryListTools">
                    <TextView
                        android:id="@+id/inventorySubtitle"
                        style="@style/InventoryCaption"
                        android:text="@string/inventory_ui_subtitle"/>
                    <!-- One compact search row: text lookup and camera in the same place. -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="8dp">
                        <EditText
                            android:id="@+id/inventorySearch"
                            style="@style/InventoryInput"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:hint="@string/inventory_ui_search"
                            android:inputType="text"
                            android:drawableStart="@drawable/ic_inventory_search"
                            android:drawablePadding="8dp"
                            android:imeOptions="actionSearch" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/inventoryScanBarcode"
                            style="@style/InventoryOutline"
                            android:layout_width="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="Quét mã"
                            android:textAllCaps="false"
                            android:contentDescription="Quét mã vạch cuốn hoặc ISBN bằng camera" />
                    </LinearLayout>
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="12dp">
                        <LinearLayout
                            android:id="@+id/inventoryCategories"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"/>
                    </HorizontalScrollView>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:id="@+id/inventoryContent"/>
            </LinearLayout>
        </ScrollView>
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/inventoryAdd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="20dp"
            android:src="@drawable/ic_inventory_add"
            android:contentDescription="@string/inventory_add"
            app:shapeAppearanceOverlay="@style/InventoryFabShape"
            app:tint="@color/white"
            app:backgroundTint="@color/library_blue"/>
    </FrameLayout>
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/library_border"/>
    <include layout="@layout/view_admin_bottom_navigation"/>
</LinearLayout>

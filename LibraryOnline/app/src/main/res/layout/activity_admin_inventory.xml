<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/inventoryRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/library_background">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="16dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <Button
                android:id="@+id/inventoryBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/catalogue_back" />
            <TextView
                style="@style/CatalogueBody"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:textStyle="bold"
                android:text="@string/inventory_title" />
        </LinearLayout>
        <TextView
            android:id="@+id/inventoryStatus"
            style="@style/CatalogueCaption"
            android:accessibilityLiveRegion="polite"
            android:text="@string/catalogue_loading" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button
                android:id="@+id/inventoryRefresh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/catalogue_refresh" />
            <Button
                android:id="@+id/inventoryAdd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/inventory_add" />
        </LinearLayout>
        <Button
            android:id="@+id/inventoryRetry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/stock_retry" />
        <EditText
            android:id="@+id/inventorySearch"
            style="@style/CatalogueInput"
            android:hint="@string/inventory_search"
            android:inputType="text"
            android:singleLine="true" />
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">
            <LinearLayout
                android:id="@+id/inventoryContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/library_border" />
    <include layout="@layout/view_admin_bottom_navigation" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="14dp" android:paddingBottom="14dp" android:orientation="vertical" android:background="@drawable/bg_reader_search">
<TextView android:id="@+id/readerOnlineItemTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingBottom="6dp" android:textSize="16sp" android:textColor="@color/text_primary" android:textStyle="bold"/>
<TextView android:id="@+id/readerOnlineItemStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingBottom="6dp" android:textSize="13sp" android:textColor="@color/text_secondary"/>
<TextView android:id="@+id/readerOnlineItemDays" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingBottom="6dp" android:textSize="13sp" android:textColor="@color/text_secondary"/>
<TextView android:id="@+id/readerOnlineItemApproved" android:text="Đã giữ sách cho bạn · Chờ lấy" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingBottom="6dp" android:textSize="16sp" android:textColor="@color/text_primary" android:textStyle="bold" android:visibility="gone"/>
<TextView android:id="@+id/readerOnlineItemCopy" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingBottom="6dp" android:textSize="13sp" android:textColor="@color/text_secondary" android:visibility="gone"/>
<TextView android:id="@+id/readerOnlineItemHold" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingBottom="6dp" android:textSize="13sp" android:textColor="@color/text_secondary" android:visibility="gone"/>
<TextView android:id="@+id/readerOnlineItemCountdown" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingBottom="6dp" android:textSize="16sp" android:textColor="@color/library_success" android:textStyle="bold" android:visibility="gone"/>
<TextView android:id="@+id/readerOnlineItemHelp" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingBottom="6dp" android:textSize="13sp" android:textColor="@color/text_secondary" android:visibility="gone" android:text="Hạn trả chỉ tính từ khi Admin thực tế giao sách tại quầy."/>
<TextView android:id="@+id/readerOnlineItemReject" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingBottom="6dp" android:textSize="13sp" android:textColor="@color/text_secondary" android:visibility="gone"/>
<TextView android:id="@+id/readerOnlineItemCheckout"
 android:layout_width="match_parent" android:layout_height="wrap_content"
 android:paddingBottom="6dp" android:textColor="@color/text_primary"
 android:textSize="14sp" android:textStyle="bold" android:visibility="gone"/>
<TextView android:id="@+id/readerOnlineItemDue"
 android:layout_width="match_parent" android:layout_height="wrap_content"
 android:paddingBottom="6dp" android:textColor="@color/text_secondary"
 android:textSize="13sp" android:visibility="gone"/>
<TextView android:id="@+id/readerOnlineItemReturned"
 android:layout_width="match_parent" android:layout_height="wrap_content"
 android:paddingBottom="6dp" android:textColor="@color/library_success"
 android:textSize="13sp" android:visibility="gone"/>
<Button android:id="@+id/readerOnlineItemCancel"
 android:layout_width="match_parent" android:layout_height="48dp"
 android:layout_marginTop="8dp" android:text="Hủy yêu cầu đang chờ duyệt"
 android:textAllCaps="false" android:backgroundTint="@color/surface"
 android:textColor="@color/library_danger" android:visibility="gone"/>
<TextView android:id="@+id/readerOnlineItemSent" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingBottom="6dp" android:textSize="13sp" android:textColor="@color/text_secondary"/></LinearLayout>

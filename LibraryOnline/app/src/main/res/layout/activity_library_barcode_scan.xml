<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp"
        android:text="Quét barcode · Library Online"
        android:textSize="19sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary" />
    <com.journeyapps.barcodescanner.DecoratedBarcodeView
        android:id="@+id/zxing_barcode_scanner"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:zxing_scanner_layout="@layout/view_library_barcode_camera" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:text="Đưa mã Code 128 trên thẻ hoặc cuốn sách vào khung. Bạn có thể quay lại để nhập mã bằng tay."
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />
    <Button
        android:id="@+id/libraryBarcodeCancel"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_margin="16dp"
        android:backgroundTint="@color/library_blue"
        android:textColor="@color/surface"
        android:textAllCaps="false"
        android:text="Hủy quét" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/library_background"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="26dp"
        android:paddingEnd="24dp"
        android:paddingBottom="28dp">
        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginBottom="8dp"
            android:contentDescription="Logo MyLibrary"
            android:src="@drawable/mylibrary_logo"
            android:scaleType="fitCenter" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MyLibrary"
            android:textColor="@color/library_blue"
            android:textSize="28sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Quên mật khẩu"
            android:textColor="@color/library_navy"
            android:textSize="25sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp"
            android:text="Nhập thông tin trùng khớp với hồ sơ thẻ thư viện. Admin sẽ kiểm tra và phê duyệt yêu cầu trước khi Firebase gửi email đặt lại mật khẩu."
            android:textColor="@color/library_muted"
            android:textSize="14sp"
            android:lineSpacingExtra="3dp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@drawable/bg_auth_card"
            android:elevation="2dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Xác minh thông tin độc giả"
                android:textColor="@color/library_navy"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="14dp" />
            <EditText
                android:id="@+id/editForgotFullName"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_auth_input"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:hint="Họ và tên"
                android:inputType="textPersonName"
                android:singleLine="true"
                android:textColor="@color/library_text"
                android:textColorHint="@color/library_muted" />
            <EditText
                android:id="@+id/editForgotBirthDate"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_auth_input"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:hint="Ngày sinh"
                android:focusable="false"
                android:clickable="true"
                android:inputType="none"
                android:textColor="@color/library_text"
                android:textColorHint="@color/library_muted" />
            <EditText
                android:id="@+id/editForgotPhone"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_auth_input"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:hint="Số điện thoại"
                android:inputType="phone"
                android:singleLine="true"
                android:textColor="@color/library_text"
                android:textColorHint="@color/library_muted" />
            <EditText
                android:id="@+id/editForgotEmail"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_auth_input"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:hint="Email / Gmail đăng ký"
                android:inputType="textEmailAddress"
                android:singleLine="true"
                android:textColor="@color/library_text"
                android:textColorHint="@color/library_muted" />
            <Button
                android:id="@+id/buttonSubmitPasswordResetRequest"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="18dp"
                android:backgroundTint="@color/library_blue"
                android:text="Gửi yêu cầu quên mật khẩu"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/adminCirculation"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:visibility="gone">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">
        <TextView
            style="@style/CatalogueHeading"
            android:text="@string/circulation_heading" />
        <TextView
            style="@style/CatalogueBody"
            android:layout_marginTop="8dp"
            android:text="@string/circulation_manual_notice" />

        <TextView
            style="@style/CatalogueHeading"
            android:layout_marginTop="24dp"
            android:text="@string/circulation_reader_barcode_label" />
        <EditText
            android:id="@+id/inputCirculationReaderBarcode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:inputType="text"
            android:hint="@string/circulation_reader_barcode_hint"
            android:autofillHints="none" />
<Button android:id="@+id/scanCirculationReaderBarcode"
            android:layout_width="match_parent" android:layout_height="48dp"
            android:layout_marginTop="6dp" android:backgroundTint="@color/library_blue"
            android:textColor="@color/surface" android:textAllCaps="false"
            android:text="Quét mã thẻ bằng camera" />

        <!-- Show this Reader's approved requests immediately after scanning a card. -->
        <LinearLayout
            android:id="@+id/panelCounterOnlineLoans"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:padding="16dp"
            android:background="@drawable/bg_admin_screen_card"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Yêu cầu mượn Online của độc giả"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />
            <TextView
                android:id="@+id/textCounterOnlineReader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Quét mã thẻ để tải yêu cầu đã được duyệt."
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:accessibilityLiveRegion="polite"/>
            <TextView
                android:id="@+id/textCounterOnlineSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"/>
            <LinearLayout
                android:id="@+id/containerCounterOnlineLoans"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"/>
        </LinearLayout>

        <TextView
            style="@style/CatalogueHeading"
            android:layout_marginTop="16dp"
            android:text="@string/circulation_copy_barcode_label" />
        <EditText
            android:id="@+id/inputCirculationCopyBarcode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:inputType="text"
            android:hint="@string/circulation_copy_barcode_hint"
            android:autofillHints="none" />
<Button android:id="@+id/scanCirculationCopyBarcode"
            android:layout_width="match_parent" android:layout_height="48dp"
            android:layout_marginTop="6dp" android:backgroundTint="@color/library_blue"
            android:textColor="@color/surface" android:textAllCaps="false"
            android:text="Quét mã cuốn bằng camera" />

        <TextView
            android:id="@+id/textCounterOnlineVerification"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Chọn yêu cầu đã duyệt rồi quét đúng cuốn sách được giữ."
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:accessibilityLiveRegion="polite"/>
        <Button
            android:id="@+id/buttonCounterOnlineCollect"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/library_blue"
            android:textColor="@color/surface"
            android:textAllCaps="false"
            android:text="Xác nhận giao sách Online"
            android:enabled="false"/>
        <Button
            android:id="@+id/buttonCounterOnlineReturn"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/library_blue"
            android:textColor="@color/surface"
            android:textAllCaps="false"
            android:text="Xác nhận nhận trả sách Online"
            android:enabled="false"/>
        <TextView
            style="@style/CatalogueHeading"
            android:layout_marginTop="16dp"
            android:text="@string/circulation_loan_days_label" />
        <EditText
            android:id="@+id/inputCirculationLoanDays"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:inputType="number"
            android:text="@string/circulation_default_days"
            android:hint="@string/circulation_loan_days_hint"
            android:autofillHints="none" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">
            <Button
                android:id="@+id/buttonCirculationBorrow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/circulation_borrow" />
            <Button
                android:id="@+id/buttonCirculationReturn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="@string/circulation_return" />
        </LinearLayout>


        <TextView
            style="@style/CatalogueHeading"
            android:layout_marginTop="24dp"
            android:text="@string/circulation_penalty_id_label" />
        <EditText
            android:id="@+id/inputCirculationPenaltyId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:inputType="text"
            android:hint="@string/circulation_penalty_id_hint"
            android:autofillHints="none" />
        <Button
            android:id="@+id/buttonCirculationCollectFine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/circulation_collect_fine" />
        <TextView
            android:id="@+id/textCirculationResult"
            style="@style/CatalogueBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:padding="16dp"
            android:background="@drawable/bg_admin_card"
            android:text="@string/circulation_idle"
            android:textIsSelectable="true" />
    </LinearLayout>
</ScrollView>

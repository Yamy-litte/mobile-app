<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
<Button android:id="@+id/adminReaderDetailBack" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:backgroundTint="@color/library_blue" android:textColor="@color/white" android:textAllCaps="false" android:text="← Trở về danh sách độc giả" />
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="15dp" android:layout_marginTop="10dp" android:background="@drawable/bg_admin_screen_card"><TextView android:id="@+id/adminReaderDetailName" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="5dp" android:paddingBottom="5dp" android:textColor="@color/text_primary" android:textSize="21sp" android:textStyle="bold" /><TextView android:id="@+id/adminReaderDetailBarcode" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="5dp" android:paddingBottom="5dp" android:textColor="@color/text_primary" android:textSize="14sp" android:textStyle="bold" /><TextView android:id="@+id/adminReaderDetailStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="5dp" android:paddingBottom="5dp" android:textColor="@color/text_primary" android:textSize="14sp" android:textStyle="bold" /><TextView android:id="@+id/adminReaderDetailExpiry" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="5dp" android:paddingBottom="5dp" android:textColor="@color/text_secondary" android:textSize="13sp" /></LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="15dp" android:layout_marginTop="10dp" android:background="@drawable/bg_admin_screen_card"><TextView android:id="@+id/adminReaderDetailHeading" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="5dp" android:paddingBottom="5dp" android:textColor="@color/text_primary" android:textSize="17sp" android:textStyle="bold" android:text="Thông tin độc giả" /><TextView android:id="@+id/adminReaderDetailEmail" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="5dp" android:paddingBottom="5dp" android:textColor="@color/text_secondary" android:textSize="14sp" /><TextView android:id="@+id/adminReaderDetailPhone" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="5dp" android:paddingBottom="5dp" android:textColor="@color/text_secondary" android:textSize="14sp" /><TextView android:id="@+id/adminReaderDetailBirth" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="5dp" android:paddingBottom="5dp" android:textColor="@color/text_secondary" android:textSize="14sp" /></LinearLayout>
<Button android:id="@+id/adminReaderDetailHistory" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:backgroundTint="@color/library_blue" android:textColor="@color/white" android:textAllCaps="false" android:text="Xem lịch sử mượn và các khoản phạt" />
<Button android:id="@+id/adminReaderDetailLock" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:backgroundTint="@color/library_blue" android:textColor="@color/white" android:textAllCaps="false" android:text="Khóa thẻ thủ công" />
<Button android:id="@+id/adminReaderDetailRenew" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:backgroundTint="@color/library_blue" android:textColor="@color/white" android:textAllCaps="false" android:text="Gia hạn thẻ thêm 1 năm" />
<TextView android:id="@+id/adminReaderDetailNote" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="5dp" android:paddingBottom="5dp" android:textColor="@color/text_secondary" android:textSize="12sp" android:text="Lịch sử mượn Online đọc từ Firestore; phiếu tại quầy và khoản phạt trả muộn đọc từ SQLite trên thiết bị Admin này. Khóa thẻ và gia hạn thẻ cần xác nhận trước khi cập nhật Firestore." /></LinearLayout>

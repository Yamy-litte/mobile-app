<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/readerAccountPassword"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="16dp"
    android:paddingBottom="32dp"
    android:visibility="gone">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <ImageView
            android:id="@+id/readerPasswordBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_inventory_back"
            android:contentDescription="Quay lại tài khoản" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Đổi mật khẩu"
            android:textColor="@color/library_navy"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_admin_card"
        android:orientation="vertical"
        android:padding="16dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Thay đổi mật khẩu"
            android:textColor="@color/library_text"
            android:textSize="17sp"
            android:textStyle="bold" />
        <TextView
            style="@style/ReaderAccountFieldLabel"
            android:text="Mật khẩu hiện tại" />
        <EditText
            android:id="@+id/readerPasswordOld"
            style="@style/ReaderAccountInput"
            android:hint="Nhập mật khẩu hiện tại"
            android:inputType="textPassword"
            android:drawableEnd="@drawable/ic_visibility_off"
            android:drawablePadding="8dp"
            android:singleLine="true"
            android:saveEnabled="false"
            android:importantForAutofill="no" />
        <TextView
            style="@style/ReaderAccountFieldLabel"
            android:text="Mật khẩu mới" />
        <EditText
            android:id="@+id/readerPasswordNew"
            style="@style/ReaderAccountInput"
            android:hint="Tối thiểu 8 ký tự"
            android:inputType="textPassword"
            android:drawableEnd="@drawable/ic_visibility_off"
            android:drawablePadding="8dp"
            android:singleLine="true"
            android:saveEnabled="false"
            android:importantForAutofill="no" />
        <TextView
            style="@style/ReaderAccountFieldLabel"
            android:text="Nhập lại mật khẩu mới" />
        <EditText
            android:id="@+id/readerPasswordConfirm"
            style="@style/ReaderAccountInput"
            android:hint="Nhập lại mật khẩu mới"
            android:inputType="textPassword"
            android:drawableEnd="@drawable/ic_visibility_off"
            android:drawablePadding="8dp"
            android:singleLine="true"
            android:saveEnabled="false"
            android:importantForAutofill="no" />
    </LinearLayout>
    <TextView
        android:id="@+id/readerPasswordStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="@color/library_danger"
        android:textSize="13sp"
        android:visibility="gone" />
    <Button
        android:id="@+id/readerPasswordSave"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="@color/library_blue"
        android:text="Cập nhật mật khẩu"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:textSize="15sp" />
</LinearLayout>

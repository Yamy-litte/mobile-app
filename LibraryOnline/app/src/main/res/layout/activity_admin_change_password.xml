<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/library_background"
    android:fillViewport="true"
    android:clipToPadding="false">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="32dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/adminPasswordBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="12dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_inventory_back"
                android:contentDescription="Quay lại" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/admin_change_password_title"
                android:textColor="@color/library_navy"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="16dp"
            android:text="@string/admin_change_password_description"
            android:textColor="@color/library_muted"
            android:textSize="14sp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_admin_card"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="20dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="7dp"
                android:text="@string/admin_current_password_label"
                android:textColor="@color/library_text"
                android:textSize="14sp"
                android:textStyle="bold" />
            <EditText
                android:id="@+id/editAdminCurrentPassword"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_auth_input"
                android:hint="@string/admin_password_current_hint"
                android:inputType="textPassword"
                android:singleLine="true"
                android:imeOptions="actionNext"
                android:drawableEnd="@drawable/ic_visibility_off"
                android:drawablePadding="8dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:saveEnabled="false"
                android:importantForAutofill="no"
                android:textColor="@color/library_text"
                android:textColorHint="@color/library_muted"
                android:textSize="15sp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="7dp"
                android:text="@string/admin_new_password_label"
                android:textColor="@color/library_text"
                android:textSize="14sp"
                android:textStyle="bold" />
            <EditText
                android:id="@+id/editAdminNewPassword"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_auth_input"
                android:hint="@string/admin_new_password_hint"
                android:inputType="textPassword"
                android:singleLine="true"
                android:imeOptions="actionNext"
                android:drawableEnd="@drawable/ic_visibility_off"
                android:drawablePadding="8dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:saveEnabled="false"
                android:importantForAutofill="no"
                android:textColor="@color/library_text"
                android:textColorHint="@color/library_muted"
                android:textSize="15sp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="7dp"
                android:text="@string/admin_confirm_password_label"
                android:textColor="@color/library_text"
                android:textSize="14sp"
                android:textStyle="bold" />
            <EditText
                android:id="@+id/editAdminConfirmPassword"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_auth_input"
                android:hint="@string/admin_confirm_password_hint"
                android:inputType="textPassword"
                android:singleLine="true"
                android:imeOptions="actionDone"
                android:drawableEnd="@drawable/ic_visibility_off"
                android:drawablePadding="8dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:saveEnabled="false"
                android:importantForAutofill="no"
                android:textColor="@color/library_text"
                android:textColorHint="@color/library_muted"
                android:textSize="15sp" />
        </LinearLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/admin_password_note"
            android:textColor="@color/library_muted"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/textAdminPasswordStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/library_danger"
            android:textSize="13sp"
            android:visibility="gone" />
        <Button
            android:id="@+id/buttonAdminChangePassword"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:backgroundTint="@color/library_blue"
            android:text="@string/admin_password_submit"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="10dp" android:padding="15dp"
    android:orientation="vertical" android:background="@drawable/bg_admin_screen_card">
    <TextView android:id="@+id/readerLoanReceipt"
        style="@style/ReaderLoansHeading" android:textSize="15sp"/>
    <TextView android:id="@+id/readerLoanCopy"
        style="@style/ReaderLoansCaption" android:layout_marginTop="7dp"/>
    <TextView android:id="@+id/readerLoanBorrow"
        style="@style/ReaderLoansCaption" android:layout_marginTop="5dp"/>
    <TextView android:id="@+id/readerLoanDue"
        style="@style/ReaderLoansCaption" android:layout_marginTop="5dp"/>
    <TextView android:id="@+id/readerLoanStatus"
        style="@style/ReaderLoansCaption" android:layout_marginTop="7dp"
        android:textStyle="bold" android:textColor="@color/text_primary"/>
</LinearLayout>
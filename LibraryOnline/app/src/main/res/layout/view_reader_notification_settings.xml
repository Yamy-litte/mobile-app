<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/readerAccountNotificationSettings"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="16dp" android:visibility="gone">
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp"
        android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:id="@+id/readerNotificationSettingsBack"
            android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_inventory_back" android:contentDescription="Quay lại tài khoản"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="Cài đặt thông báo"
            android:textColor="@color/library_navy" android:textSize="22sp" android:textStyle="bold"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="18dp" android:padding="16dp"
        android:background="@drawable/bg_admin_card" android:orientation="vertical">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Tùy chọn nhắc nhở" android:textColor="@color/library_text"
            android:textSize="17sp" android:textStyle="bold"/>
        <androidx.appcompat.widget.SwitchCompat android:id="@+id/readerSettingsAlertsEnabled"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:minHeight="48dp" android:checked="true"
            android:text="Nhận thông báo" android:textColor="@color/library_text"/>
        <androidx.appcompat.widget.SwitchCompat android:id="@+id/readerSettingsAlertsOffline"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:minHeight="48dp" android:checked="true"
            android:text="Nhắc cục bộ khi mất mạng" android:textColor="@color/library_text"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:textColor="@color/library_muted"
            android:textSize="13sp" android:text="Nhắc theo lịch lưu trên thiết bị; thông báo mới cập nhật khi có mạng."/>
        <TextView android:id="@+id/readerSettingsPermissionStatus"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:textColor="@color/library_muted" android:textSize="13sp"/>
        <TextView android:id="@+id/readerSettingsSystemPermission"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="Mở cài đặt thông báo Android"
            android:textColor="@color/library_blue" android:textStyle="bold" android:visibility="gone"/>
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="22dp" android:text="Nhắc đã lên lịch"
        android:textColor="@color/library_text" android:textSize="17sp" android:textStyle="bold"/>
    <TextView android:id="@+id/readerSettingsScheduledSummary"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:text="Đang tải lịch nhắc..."
        android:textColor="@color/library_muted" android:textSize="13sp"/>
    <LinearLayout android:id="@+id/readerSettingsScheduled"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical"/>
</LinearLayout>
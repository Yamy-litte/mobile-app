<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="ReaderAccountActionRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">54dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:background">@drawable/bg_reader_search</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
    <style name="ReaderAccountActionIcon">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
    </style>
    <style name="ReaderAccountActionLabel">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">14dp</item>
        <item name="android:textColor">@color/library_text</item>
        <item name="android:textSize">15sp</item>
    </style>
    <style name="ReaderAccountActionChevron">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/library_muted</item>
        <item name="android:textSize">26sp</item>
    </style>
    <style name="ReaderAccountFieldLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:textColor">@color/library_muted</item>
        <item name="android:textSize">13sp</item>
    </style>
    <style name="ReaderAccountReadOnlyField">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">50dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:background">@drawable/bg_reader_search</item>
        <item name="android:textColor">@color/library_text</item>
        <item name="android:textSize">15sp</item>
    </style>
    <style name="ReaderAccountInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:background">@drawable/bg_reader_search</item>
        <item name="android:textColor">@color/library_text</item>
        <item name="android:textColorHint">@color/library_muted</item>
        <item name="android:textSize">15sp</item>
    </style>
</resources>

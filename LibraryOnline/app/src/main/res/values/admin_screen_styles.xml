<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AdminScreenHeading">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">serif</item>
        <item name="android:textColor">@color/admin_screen_ink</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">21sp</item>
        <item name="android:layout_marginTop">22dp</item>
        <item name="android:layout_marginBottom">12dp</item>
    </style>
    <style name="AdminScreenCaption">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/admin_screen_muted</item>
        <item name="android:textSize">13sp</item>
    </style>
    <style name="AdminScreenKpiNumber">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">end</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/admin_screen_primary</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
    </style>
    <style name="AdminScreenKpiCard">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">104dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">5dp</item>
        <item name="android:padding">14dp</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/bg_admin_screen_card</item>
    </style>
    <style name="AdminScreenActionRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">54dp</item>
        <item name="android:layout_marginBottom">9dp</item>
        <item name="android:paddingStart">15dp</item>
        <item name="android:paddingEnd">15dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:background">@drawable/bg_admin_screen_card</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
    <style name="AdminScreenFieldLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:layout_marginBottom">7dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/admin_screen_muted</item>
    </style>
    <style name="AdminScreenField">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:background">@drawable/bg_admin_screen_field</item>
        <item name="android:textColor">@color/admin_screen_ink</item>
        <item name="android:textColorHint">@color/admin_screen_muted</item>
        <item name="android:textSize">15sp</item>
    </style>
    <style name="AdminScreenActionText">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">13dp</item>
        <item name="android:textColor">@color/admin_screen_ink</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.LibraryOnline" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/library_blue</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/library_navy</item>
        <item name="colorSurface">@color/surface</item>
        <!-- Material 3 cards, dialogs and elevated containers must stay white. -->
        <item name="colorSurfaceContainerLowest">@color/surface</item>
        <item name="colorSurfaceContainerLow">@color/surface</item>
        <item name="colorSurfaceContainer">@color/surface</item>
        <item name="colorSurfaceContainerHigh">@color/surface</item>
        <item name="colorSurfaceContainerHighest">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/border</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:colorBackgroundFloating">@color/surface</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:colorAccent">@color/library_blue</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/background</item>
    </style>

    <style name="Theme.LibraryOnline" parent="Base.Theme.LibraryOnline" />
</resources>
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/Admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/Admins/$(request.auth.uid)).data.adminStatus in ['Active', 'HoatDong'];
    }

    function validRegistrationRequest(requestId) {
      return request.resource.data.keys().hasAll([
          'fullName', 'birthDate', 'email', 'phone', 'termsAccepted',
          'termsAcceptedAt', 'status', 'emailVerified', 'phoneVerified',
          'rejectionReason', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'fullName', 'birthDate', 'email', 'phone', 'termsAccepted',
          'termsAcceptedAt', 'status', 'emailVerified', 'phoneVerified',
          'rejectionReason', 'createdAt'
        ])
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() >= 2
        && request.resource.data.fullName.size() <= 120
        && request.resource.data.birthDate is string
        && request.resource.data.birthDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$')
        && request.resource.data.phone is string
        && request.resource.data.phone.matches('^0(3|5|7|8|9)[0-9]{8}$')
        && request.resource.data.termsAccepted == true
        && request.resource.data.termsAcceptedAt == request.time
        && request.resource.data.status == 'Pending'
        && request.resource.data.emailVerified == true
        && request.resource.data.phoneVerified == false
        && request.resource.data.rejectionReason == ''
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/RegistrationEmailIndex/$(request.resource.data.email)).data.value == request.resource.data.email
        && getAfter(/databases/$(database)/documents/RegistrationEmailIndex/$(request.resource.data.email)).data.requestId == requestId
        && getAfter(/databases/$(database)/documents/RegistrationPhoneIndex/$(request.resource.data.phone)).data.value == request.resource.data.phone
        && getAfter(/databases/$(database)/documents/RegistrationPhoneIndex/$(request.resource.data.phone)).data.requestId == requestId;
    }

    match /Admins/{adminId} {
      allow read: if signedIn() && request.auth.uid == adminId;
      allow create, delete: if false;
      allow update: if signedIn()
        && request.auth.uid == adminId
        && isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'fullName', 'phone', 'dateOfBirth', 'email', 'updatedAt'
        ])
        // Once an Admin email exists, it must remain unchanged.
        && (
          ('email' in resource.data && request.resource.data.email == resource.data.email)
          || (!('email' in resource.data)
              && request.auth.token.email is string
              && request.resource.data.email == request.auth.token.email)
        )
        // Optional on legacy Admin documents, ISO formatted when present.
        && (!('dateOfBirth' in request.resource.data)
            || (request.resource.data.dateOfBirth is string
                && request.resource.data.dateOfBirth.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() >= 2
        && request.resource.data.fullName.size() <= 120
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$')
        && request.resource.data.phone is string
        && (request.resource.data.phone == ''
            || request.resource.data.phone.matches('^0(3|5|7|8|9)[0-9]{8}$'))
        && request.resource.data.updatedAt == request.time;
    }

    match /Users/{userId} {
      allow read: if (signedIn() && request.auth.uid == userId) || isAdmin();
      allow create: if isAdmin()
        && request.resource.data.userId == userId
        && request.resource.data.role == 'Reader'
        && request.resource.data.cardStatus == 'HoatDong'
        && request.resource.data.email is string
        && request.resource.data.phone is string;
      allow update: if (
          signedIn()
          && request.auth.uid == userId
          && resource.data.mustChangePassword == true
          && request.resource.data.mustChangePassword == false
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mustChangePassword', 'updatedAt'])
        ) || (
          isAdmin()
          && resource.data.role == 'Reader'
          && request.resource.data.role == resource.data.role
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cardStatus', 'cardExpiryDate', 'updatedAt'])
          && request.resource.data.cardStatus in ['HoatDong', 'BiKhoa', 'HetHan']
          && request.resource.data.cardExpiryDate is string
          && request.resource.data.cardExpiryDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.updatedAt == request.time
        );
      allow delete: if false;
    }

    match /RegistrationEmailIndex/{email} {
      allow create: if !exists(/databases/$(database)/documents/RegistrationEmailIndex/$(email))
        && request.resource.data.keys().hasOnly(['value', 'requestId', 'createdAt'])
        && request.resource.data.value == email
        && request.resource.data.requestId is string
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/RegistrationRequests/$(request.resource.data.requestId)).data.email == email;
      allow read, update, delete: if false;
    }

    match /RegistrationPhoneIndex/{phone} {
      allow create: if !exists(/databases/$(database)/documents/RegistrationPhoneIndex/$(phone))
        && request.resource.data.keys().hasOnly(['value', 'requestId', 'createdAt'])
        && request.resource.data.value == phone
        && request.resource.data.requestId is string
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/RegistrationRequests/$(request.resource.data.requestId)).data.phone == phone;
      allow read, update, delete: if false;
    }

    function validPasswordResetRequest() {
      return request.resource.data.keys().hasAll([
          'fullName', 'birthDate', 'email', 'phone', 'status', 'rejectionReason', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'fullName', 'birthDate', 'email', 'phone', 'status', 'rejectionReason', 'createdAt'
        ])
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() >= 2
        && request.resource.data.fullName.size() <= 120
        && request.resource.data.birthDate is string
        && request.resource.data.birthDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$')
        && request.resource.data.phone is string
        && request.resource.data.phone.matches('^0(3|5|7|8|9)[0-9]{8}$')
        && request.resource.data.status == 'Pending'
        && request.resource.data.rejectionReason == ''
        && request.resource.data.createdAt == request.time;
    }

    match /PasswordResetRequests/{requestId} {
      allow create: if validPasswordResetRequest();
      allow read: if isAdmin();
      allow update: if isAdmin()
        && resource.data.status == 'Pending'
        && request.resource.data.status in ['Approved', 'Rejected']
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'rejectionReason', 'reviewedBy', 'reviewedAt'
        ])
        && (
          (request.resource.data.status == 'Approved'
            && request.resource.data.rejectionReason == resource.data.rejectionReason)
          ||
          (request.resource.data.status == 'Rejected'
            && request.resource.data.rejectionReason is string
            && request.resource.data.rejectionReason.size() >= 3
            && request.resource.data.rejectionReason.size() <= 500)
        );
      allow delete: if false;
    }

    // The Android approval batch must create a matching profile before review is final.
    function approvedProfileMatches() {
      let user = getAfter(/databases/$(database)/documents/Users/$(request.resource.data.userId)).data;
      return user.userId == request.resource.data.userId
        && user.role == 'Reader'
        && user.cardStatus == 'HoatDong'
        && user.fullName == resource.data.fullName
        && user.dateOfBirth == resource.data.birthDate
        && user.email == resource.data.email
        && user.phone == resource.data.phone
        && user.barcode == request.resource.data.barcode;
    }

    match /RegistrationRequests/{requestId} {
      allow create: if validRegistrationRequest(requestId);
      allow read: if isAdmin();
      allow update: if isAdmin()
        && resource.data.status in ['Pending', 'PendingVerification']
        && request.resource.data.status in ['Approved', 'Rejected']
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'rejectionReason', 'reviewedBy', 'reviewedAt', 'userId', 'barcode'
        ])
        && (
          (request.resource.data.status == 'Approved'
            && request.resource.data.userId is string
            && request.resource.data.barcode is string
            && approvedProfileMatches()
            && request.resource.data.rejectionReason == resource.data.rejectionReason)
          ||
          (request.resource.data.status == 'Rejected'
            && request.resource.data.rejectionReason is string
            && request.resource.data.rejectionReason.size() >= 3
            && request.resource.data.rejectionReason.size() <= 500
            && !request.resource.data.keys().hasAny(['userId', 'barcode']))
        );
      allow delete: if false;
    }

    // Categories are readable by signed-in readers; only active admins can maintain them.
    match /Categories/{categoryId} {
      allow read: if signedIn();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasAll(['categoryId', 'name', 'isActive'])
        && request.resource.data.categoryId == categoryId
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.isActive is bool;
      allow delete: if false;
    }

    // Readers can browse. Only active admins can create/update catalogue documents.
    // Deletion is logical (isHidden) so loan history is not orphaned.
    match /BookTitles/{bookTitleId} {
      allow read: if signedIn();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasAll([
          'title', 'author', 'isbn', 'categoryId', 'publisher', 'publishYear',
          'description', 'coverUrl', 'totalCopies', 'availableCopies', 'isHidden'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.categoryId is string
        && request.resource.data.categoryId.size() > 0
        && !request.resource.data.keys().hasAny(['category'])
        && getAfter(/databases/$(database)/documents/Categories/$(request.resource.data.categoryId)).data.categoryId == request.resource.data.categoryId
        && (!request.resource.data.keys().hasAny(['bookTitleId'])
            || request.resource.data.bookTitleId == bookTitleId)
        && request.resource.data.author is string
        && request.resource.data.isbn is string
        && request.resource.data.publisher is string
        && (request.resource.data.publishYear == null || request.resource.data.publishYear is int)
        && request.resource.data.description is string
        && request.resource.data.coverUrl is string
        && request.resource.data.totalCopies is int
        && request.resource.data.totalCopies >= 0
        && request.resource.data.availableCopies is int
        && request.resource.data.availableCopies >= 0
        && request.resource.data.availableCopies <= request.resource.data.totalCopies
        && request.resource.data.isHidden is bool;
      allow delete: if false;
    }

    // Flow 2: one ready copy is hidden/retired with its parent counter in the same transaction.
    function validInventoryTransition() {
      let old = resource.data;
      let next = request.resource.data;
      let parent = /databases/$(database)/documents/BookTitles/$(old.bookTitleId);
      let restoreRepairCopy =
          old.copyStatus == 'DangSuaChua'
          && old.isHidden == true
          && old.priorityUserId == null
          && next.copyStatus == 'SanSang'
          && next.isHidden == false
          && next.priorityUserId == null
          && next.diff(old).affectedKeys().hasOnly(['copyStatus', 'isHidden', 'updatedAt'])
          && next.updatedAt == request.time
          && get(parent).data.isHidden == false
          && getAfter(parent).data.isHidden == false
          && getAfter(parent).data.availableCopies == get(parent).data.availableCopies + 1
          && getAfter(parent).data.totalCopies == get(parent).data.totalCopies;
      return (
          // Existing hide/retire behaviour remains unchanged.
          (!(old.copyStatus in ['DangSuaChua', 'ThanhLy', 'DaMat'])
              || (next.copyStatus == old.copyStatus && next.isHidden == old.isHidden))
          && (!(next.copyStatus in ['DangSuaChua', 'ThanhLy']) || next.copyStatus == old.copyStatus
              || (old.copyStatus == 'SanSang' && old.isHidden == false
                  && old.priorityUserId == null && next.priorityUserId == null && next.isHidden == true
                  && getAfter(parent).data.availableCopies == get(parent).data.availableCopies - 1
                  && getAfter(parent).data.totalCopies == get(parent).data.totalCopies))
          && (next.isHidden == old.isHidden || (next.isHidden == true
              && next.copyStatus in ['DangSuaChua', 'ThanhLy']))
        ) || restoreRepairCopy;
    }

    // Physical copies: readers may inspect availability; only active admins mutate inventory.
    match /BookCopies/{copyId} {
      allow read: if signedIn();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasAll([
          'bookTitleId', 'barcode', 'shelfLocation', 'copyStatus', 'priorityUserId', 'isHidden'
        ])
        && request.resource.data.bookTitleId is string
        && request.resource.data.bookTitleId.size() > 0
        && existsAfter(/databases/$(database)/documents/BookTitles/$(request.resource.data.bookTitleId))
        && request.resource.data.barcode is string
        && request.resource.data.barcode.size() > 0
        && request.resource.data.shelfLocation is string
        && (request.method == 'create'
            || (request.resource.data.bookTitleId == resource.data.bookTitleId
                && request.resource.data.barcode == resource.data.barcode))
        && (!request.resource.data.keys().hasAny(['copyId']) || request.resource.data.copyId == copyId)
        && (request.resource.data.priorityUserId == null
            || (request.resource.data.priorityUserId is string
                && getAfter(/databases/$(database)/documents/Users/$(request.resource.data.priorityUserId)).data.role == 'Reader'))
        && (request.resource.data.copyStatus != 'DaDatTruoc'
            || request.resource.data.priorityUserId is string)
        && (request.method == 'create'
            || !(resource.data.copyStatus in ['DaMuon', 'ChoLay', 'DaDatTruoc'])
            || (!(request.resource.data.copyStatus in ['ThanhLy', 'DangSuaChua'])
                && request.resource.data.isHidden == false))
        && request.resource.data.copyStatus in [
          'SanSang', 'ChoLay', 'DaMuon', 'DaDatTruoc', 'DangSuaChua', 'ThanhLy', 'DaMat'
        ]
        && request.resource.data.isHidden is bool
        && (request.method == 'create' || validInventoryTransition());
      allow delete: if false;
    }

    match /SystemConfigs/{configId} {
      allow read: if isAdmin() || (signedIn() && configId == 'default');
      allow create, update: if isAdmin()
        && configId == 'default'
        && request.resource.data.keys().hasAll([
          'configId', 'maxBooksPerUser', 'maxLoanDays', 'onlineHoldHours',
          'reservationHoldHours', 'lateFeePerDay', 'lostBookMultiplier', 'updatedBy', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'configId', 'maxBooksPerUser', 'maxLoanDays', 'onlineHoldHours',
          'reservationHoldHours', 'lateFeePerDay', 'lostBookMultiplier', 'updatedBy', 'updatedAt'
        ])
        && request.resource.data.configId == configId
        && request.resource.data.maxBooksPerUser is int
        && request.resource.data.maxBooksPerUser >= 1
        && request.resource.data.maxBooksPerUser <= 20
        && request.resource.data.maxLoanDays is int
        && request.resource.data.maxLoanDays >= 1
        && request.resource.data.maxLoanDays <= 60
        && request.resource.data.onlineHoldHours is int
        && request.resource.data.onlineHoldHours >= 1
        && request.resource.data.onlineHoldHours <= 168
        && request.resource.data.reservationHoldHours is int
        && request.resource.data.reservationHoldHours >= 1
        && request.resource.data.reservationHoldHours <= 336
        && request.resource.data.lateFeePerDay is int
        && request.resource.data.lateFeePerDay >= 0
        && request.resource.data.lateFeePerDay <= 1000000
        && request.resource.data.lostBookMultiplier is int
        && request.resource.data.lostBookMultiplier >= 1
        && request.resource.data.lostBookMultiplier <= 10
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // Online borrowing only. Do NOT reintroduce DatTruoc/queue records.
    // One deterministic request document per reader + book title prevents concurrent
    // duplicate requests for the same title. Rejection/expiry allows a new attempt.
    function activeOnlineReader(userId) {
      return signedIn()
        && exists(/databases/$(database)/documents/Users/$(userId))
        && get(/databases/$(database)/documents/Users/$(userId)).data.role == 'Reader'
        && get(/databases/$(database)/documents/Users/$(userId)).data.cardStatus == 'HoatDong';
    }

    function validOnlineLoanDays(days) {
      return days is int && days >= 1
        && (
          (!exists(/databases/$(database)/documents/SystemConfigs/default) && days <= 14)
          || (exists(/databases/$(database)/documents/SystemConfigs/default)
              && days <= get(/databases/$(database)/documents/SystemConfigs/default).data.maxLoanDays)
        );
    }

    function validNewOnlineRequest(id) {
      let value = request.resource.data;
      let titlePath = /databases/$(database)/documents/BookTitles/$(value.bookTitleId);
      return signedIn()
        && value.keys().hasAll([
          'requestId', 'userId', 'bookTitleId', 'bookTitle',
          'loanDays', 'status', 'attempt', 'createdAt', 'updatedAt'
        ])
        && value.keys().hasOnly([
          'requestId', 'userId', 'bookTitleId', 'bookTitle',
          'loanDays', 'status', 'attempt', 'createdAt', 'updatedAt'
        ])
        && value.userId == request.auth.uid
        && value.bookTitleId is string
        && value.bookTitleId.size() > 0
        && id == request.auth.uid + '_' + value.bookTitleId
        && value.requestId == id
        && activeOnlineReader(request.auth.uid)
        && exists(titlePath)
        && get(titlePath).data.isHidden == false
        && get(titlePath).data.availableCopies > 0
        && value.bookTitle == get(titlePath).data.title
        && validOnlineLoanDays(value.loanDays)
        && value.status == 'Pending'
        && value.attempt == 1
        && value.createdAt == request.time
        && value.updatedAt == request.time;
    }

    function onlineDecisionNotice() {
      let notificationPath =
          /databases/$(database)/documents/OnlineLoanNotifications/$(request.resource.data.notificationId);
      return request.resource.data.notificationId is string
        && existsAfter(notificationPath)
        && getAfter(notificationPath).data.requestId == resource.data.requestId
        && getAfter(notificationPath).data.userId == resource.data.userId
        && getAfter(notificationPath).data.status == request.resource.data.status
        && getAfter(notificationPath).data.attempt == resource.data.attempt
        && getAfter(notificationPath).data.createdAt == request.time
        && getAfter(notificationPath).data.readAt == null;
    }

    function validOnlineApproval() {
      let next = request.resource.data;
      let copyPath = /databases/$(database)/documents/BookCopies/$(next.copyId);
      let titlePath = /databases/$(database)/documents/BookTitles/$(resource.data.bookTitleId);
      return next.status == 'Approved'
        && next.diff(resource.data).affectedKeys().hasOnly([
          'status', 'copyId', 'holdUntil', 'reviewedBy', 'reviewedAt',
          'notificationId', 'updatedAt'
        ])
        && next.copyId is string
        && next.copyId.size() > 0
        && next.holdUntil is timestamp
        && next.holdUntil > request.time
        && next.holdUntil <= request.time + duration.value(25, 'h')
        && exists(copyPath)
        && get(copyPath).data.bookTitleId == resource.data.bookTitleId
        && get(copyPath).data.copyStatus == 'SanSang'
        && get(copyPath).data.isHidden == false
        && get(copyPath).data.priorityUserId == null
        && getAfter(copyPath).data.copyStatus == 'ChoLay'
        && getAfter(copyPath).data.isHidden == false
        && getAfter(copyPath).data.priorityUserId == resource.data.userId
        && getAfter(copyPath).data.diff(get(copyPath).data).affectedKeys()
            .hasOnly(['copyStatus', 'priorityUserId', 'updatedAt'])
        && getAfter(copyPath).data.updatedAt == request.time
        && get(titlePath).data.isHidden == false
        && get(titlePath).data.availableCopies > 0
        && getAfter(titlePath).data.availableCopies == get(titlePath).data.availableCopies - 1
        && getAfter(titlePath).data.totalCopies == get(titlePath).data.totalCopies
        && getAfter(titlePath).data.updatedAt == request.time
        && activeOnlineReader(resource.data.userId)
        && onlineDecisionNotice();
    }

    function validOnlineRejection() {
      let next = request.resource.data;
      return next.status == 'Rejected'
        && next.diff(resource.data).affectedKeys().hasOnly([
          'status', 'rejectionReason', 'reviewedBy', 'reviewedAt',
          'notificationId', 'updatedAt'
        ])
        && next.rejectionReason is string
        && next.rejectionReason.size() >= 5
        && next.rejectionReason.size() <= 500
        && onlineDecisionNotice();
    }

    function validOnlineExpiry() {
      let next = request.resource.data;
      let copyPath = /databases/$(database)/documents/BookCopies/$(resource.data.copyId);
      let titlePath = /databases/$(database)/documents/BookTitles/$(resource.data.bookTitleId);
      return resource.data.status == 'Approved'
        && next.status == 'Expired'
        && resource.data.holdUntil is timestamp
        && request.time >= resource.data.holdUntil
        && next.diff(resource.data).affectedKeys().hasOnly([
          'status', 'notificationId', 'updatedAt'
        ])
        && exists(copyPath)
        && get(copyPath).data.copyStatus == 'ChoLay'
        && get(copyPath).data.priorityUserId == resource.data.userId
        && get(copyPath).data.isHidden == false
        && getAfter(copyPath).data.copyStatus == 'SanSang'
        && getAfter(copyPath).data.priorityUserId == null
        && getAfter(copyPath).data.isHidden == false
        && getAfter(copyPath).data.diff(get(copyPath).data).affectedKeys()
            .hasOnly(['copyStatus', 'priorityUserId', 'updatedAt'])
        && getAfter(copyPath).data.updatedAt == request.time
        && getAfter(titlePath).data.availableCopies == get(titlePath).data.availableCopies + 1
        && getAfter(titlePath).data.totalCopies == get(titlePath).data.totalCopies
        && getAfter(titlePath).data.updatedAt == request.time
        && onlineDecisionNotice();
    }

    match /OnlineLoanRequests/{requestId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if validNewOnlineRequest(requestId);
      allow update: if (
        // Reader re-submits a rejected/expired request; previous decision metadata
        // must be cleared, and attempt must increase, preserving the same title.
        signedIn()
        && request.auth.uid == resource.data.userId
        && resource.data.status in ['Rejected', 'Expired']
        && request.resource.data.keys().hasOnly([
          'requestId', 'userId', 'bookTitleId', 'bookTitle',
          'loanDays', 'status', 'attempt', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.requestId == resource.data.requestId
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.bookTitleId == resource.data.bookTitleId
        && request.resource.data.bookTitle == resource.data.bookTitle
        && request.resource.data.attempt == resource.data.attempt + 1
        && request.resource.data.status == 'Pending'
        && validOnlineLoanDays(request.resource.data.loanDays)
        && activeOnlineReader(request.auth.uid)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && get(/databases/$(database)/documents/BookTitles/$(resource.data.bookTitleId)).data.isHidden == false
        && get(/databases/$(database)/documents/BookTitles/$(resource.data.bookTitleId)).data.availableCopies > 0
      ) || (
        isAdmin()
        && resource.data.status == 'Pending'
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.bookTitleId == resource.data.bookTitleId
        && request.resource.data.requestId == resource.data.requestId
        && request.resource.data.attempt == resource.data.attempt
        && request.resource.data.loanDays == resource.data.loanDays
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewedAt == request.time
        && request.resource.data.updatedAt == request.time
        && (validOnlineApproval() || validOnlineRejection())
      ) || (
        isAdmin()
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.bookTitleId == resource.data.bookTitleId
        && request.resource.data.requestId == resource.data.requestId
        && request.resource.data.attempt == resource.data.attempt
        && request.resource.data.loanDays == resource.data.loanDays
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && validOnlineExpiry()
      );
      allow delete: if false;
    }

    match /OnlineLoanNotifications/{notificationId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if isAdmin()
        && request.resource.data.keys().hasAll([
          'requestId', 'userId', 'status', 'attempt', 'title',
          'message', 'createdAt', 'readAt'
        ])
        && request.resource.data.keys().hasOnly([
          'requestId', 'userId', 'status', 'attempt', 'title',
          'message', 'createdAt', 'readAt'
        ])
        && request.resource.data.status in ['Approved', 'Rejected', 'Expired']
        && request.resource.data.attempt is int
        && request.resource.data.title is string
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 500
        && request.resource.data.createdAt == request.time
        && request.resource.data.readAt == null
        && exists(/databases/$(database)/documents/OnlineLoanRequests/$(request.resource.data.requestId))
        && getAfter(/databases/$(database)/documents/OnlineLoanRequests/$(request.resource.data.requestId)).data.notificationId == notificationId
        && getAfter(/databases/$(database)/documents/OnlineLoanRequests/$(request.resource.data.requestId)).data.userId == request.resource.data.userId
        && getAfter(/databases/$(database)/documents/OnlineLoanRequests/$(request.resource.data.requestId)).data.status == request.resource.data.status
        && getAfter(/databases/$(database)/documents/OnlineLoanRequests/$(request.resource.data.requestId)).data.attempt == request.resource.data.attempt;
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && resource.data.readAt == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt'])
        && request.resource.data.readAt == request.time;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="#FFF8EF"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <TextView
                android:id="@+id/txtDetailBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="‹"
                android:textColor="#205D52"
                android:textSize="36sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Chi tiết sách"
                android:textColor="#183D35"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtDetailFavorite"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_detail_circle"
                android:gravity="center"
                android:text="♡"
                android:textColor="#205D52"
                android:textSize="30sp" />

        </LinearLayout>

        <!-- Book cover -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="290dp"
            android:background="#FFFFFF"
            android:foregroundGravity="center">

            <ImageView
                android:id="@+id/imgBookCover"
                android:layout_width="200dp"
                android:layout_height="260dp"
                android:layout_gravity="center"
                android:contentDescription="Ảnh bìa sách"
                android:scaleType="fitCenter"
                android:src="@android:drawable/ic_menu_gallery" />

        </FrameLayout>

        <!-- Existing book information -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/txtDetailTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tên sách"
                android:textColor="#183D35"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtDetailRating"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Chưa có đánh giá"
                android:textColor="#B7791F"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/txtDetailAuthor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Tác giả"
                android:textColor="#64736F"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/txtDetailCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Danh mục"
                android:textColor="#205D52"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Giới thiệu sách"
                android:textColor="#183D35"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtDetailDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="5dp"
                android:text="Mô tả sách"
                android:textColor="#64736F"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/txtDetailStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="#E7F3EB"
                android:padding="10dp"
                android:text="Trạng thái"
                android:textColor="#315C45"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>

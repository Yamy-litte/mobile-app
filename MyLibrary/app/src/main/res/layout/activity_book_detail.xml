<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F5F7"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Book Details"
        android:textColor="#1F4E5F"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvBookTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Title"
                android:textColor="#1F4E5F"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvBookAuthor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Author"
                android:textColor="#5F6B7A"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/tvBookPublisher"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Publisher"
                android:textColor="#5F6B7A"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/tvBookYear"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Year"
                android:textColor="#5F6B7A"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/tvBookSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Summary"
                android:textColor="#1A1A1A"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/tvAvailableQuantity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Available: 0"
                android:textColor="#5FAE62"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="24dp" />
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btnReserve"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="#5FAE62"
        android:text="Reserve Book" />

    <Button
        android:id="@+id/btnBorrow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:backgroundTint="#1F4E5F"
        android:text="Borrow Book" />
</LinearLayout>

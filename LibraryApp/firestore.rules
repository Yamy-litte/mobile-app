rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // The demo Admin is provisioned explicitly. Never grant Admin rights by
    // accepting a role supplied by a client.
    function isAdmin() {
      return signedIn() && request.auth.uid == "hDZ5s2jS35ah0J98pVKAM2QQNxx2";
    }

    match /books/{bookId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /customers/{customerUid} {
      allow read: if signedIn() && (request.auth.uid == customerUid || isAdmin());
      allow create: if signedIn()
        && request.auth.uid == customerUid
        && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn() && request.auth.uid == customerUid
        && request.resource.data.uid == resource.data.uid;
      allow delete: if isAdmin();
    }

    match /reservations/{reservationId} {
      allow read: if signedIn()
        && (resource.data.customerUid == request.auth.uid || isAdmin());
      allow create: if signedIn()
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.status == "pending";
      allow update: if isAdmin();
      allow delete: if isAdmin()
        || (signedIn() && resource.data.customerUid == request.auth.uid
          && resource.data.status == "pending");
    }

    match /borrowRecords/{recordId} {
      allow read: if signedIn()
        && (resource.data.customerUid == request.auth.uid || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if signedIn()
        && resource.data.customerUid == request.auth.uid;
      allow create: if isAdmin();
      allow update: if signedIn()
        && resource.data.customerUid == request.auth.uid
        && request.resource.data.customerUid == resource.data.customerUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
      allow delete: if isAdmin();
    }
  }
}

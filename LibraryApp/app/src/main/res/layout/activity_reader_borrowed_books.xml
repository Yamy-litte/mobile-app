<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="@color/mylibrary_cream">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MyLibrary"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/mylibrary_teal"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Mượn sách"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/mylibrary_ink"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Theo dõi trạng thái và hạn trả sách đã mượn."
            android:textColor="@color/mylibrary_muted"
            android:textSize="14sp"/>
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button android:id="@+id/filterAllLoans" android:layout_width="wrap_content" android:layout_height="40dp" android:layout_marginEnd="8dp" android:text="Tất cả" android:textAllCaps="false" android:backgroundTint="@color/mylibrary_teal" android:textColor="@color/white"/>
            <Button android:id="@+id/filterActiveLoans" android:layout_width="wrap_content" android:layout_height="40dp" android:layout_marginEnd="8dp" android:text="Đang mượn" android:textAllCaps="false" android:backgroundTint="@color/mylibrary_cream" android:textColor="@color/mylibrary_ink"/>
            <Button android:id="@+id/filterPendingLoans" android:layout_width="wrap_content" android:layout_height="40dp" android:layout_marginEnd="8dp" android:text="Yêu cầu" android:textAllCaps="false" android:backgroundTint="@color/mylibrary_cream" android:textColor="@color/mylibrary_ink"/>
            <Button android:id="@+id/filterHistoryLoans" android:layout_width="wrap_content" android:layout_height="40dp" android:text="Lịch sử" android:textAllCaps="false" android:backgroundTint="@color/mylibrary_cream" android:textColor="@color/mylibrary_ink"/>
        </LinearLayout>
    </HorizontalScrollView>

    <TextView
        android:id="@+id/textBorrowedEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="24dp"
        android:text="Bạn chưa có sách đang mượn."
        android:textColor="@color/mylibrary_muted"
        android:visibility="gone"/>

    <ListView
        android:id="@+id/listBorrowedBooks"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:divider="@android:color/transparent"
        android:dividerHeight="8dp"
        android:clipToPadding="false"
        android:background="@color/mylibrary_cream"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@android:color/white"
        android:elevation="8dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">
        <LinearLayout android:id="@+id/tabHome" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:clickable="true" android:focusable="true">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⌂" android:textSize="22sp" android:textColor="@color/mylibrary_muted"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Trang chủ" android:textSize="11sp" android:textColor="@color/mylibrary_muted"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/tabBorrowedBooks" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:clickable="true" android:focusable="true">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="▤" android:textSize="21sp" android:textColor="@color/mylibrary_teal"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Mượn sách" android:textSize="11sp" android:textColor="@color/mylibrary_teal"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/tabNotifications" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:clickable="true" android:focusable="true">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="♧" android:textSize="21sp" android:textColor="@color/mylibrary_muted"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Thông báo" android:textSize="11sp" android:textColor="@color/mylibrary_muted"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/tabAccount" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:clickable="true" android:focusable="true">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="●" android:textSize="18sp" android:textColor="@color/mylibrary_muted"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tài khoản" android:textSize="11sp" android:textColor="@color/mylibrary_muted"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
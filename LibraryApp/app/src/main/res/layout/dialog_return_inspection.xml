<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">
        <TextView
            android:id="@+id/textReturnInspectionSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/mylibrary_ink"
            android:textSize="15sp"
            android:lineSpacingExtra="3dp"/>
        <CheckBox
            android:id="@+id/checkBookDamaged"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Sách bị hư hại"/>
        <EditText
            android:id="@+id/editDamageDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Mô tả hư hại (nếu có)"
            android:inputType="textCapSentences|textMultiLine"
            android:minLines="2"
            android:gravity="top"/>
        <EditText
            android:id="@+id/editLateFee"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Phí trả trễ (VNĐ), nhập 0 nếu không có"
            android:inputType="number"
            android:text="0"/>
        <EditText
            android:id="@+id/editDamageFee"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Phí hư hại (VNĐ), nhập 0 nếu không có"
            android:inputType="number"
            android:text="0"/>
        <CheckBox
            android:id="@+id/checkFeeCollected"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Đã thu phí từ độc giả (nếu có)"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Phí do Admin nhập theo quy định của thư viện. Ứng dụng chưa tự đặt mức phí."
            android:textColor="@color/mylibrary_muted"
            android:textSize="12sp"/>
    </LinearLayout>
</ScrollView>
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/mylibrary_cream">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="MyLibrary · THẺ ĐỘC GIẢ"
        android:textColor="@color/mylibrary_teal"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/digitalCardName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:textColor="@color/mylibrary_ink"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/digitalCardEmail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/mylibrary_muted"
        android:textSize="14sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="MÃ ĐỘC GIẢ"
        android:textColor="@color/mylibrary_muted"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/digitalCardNumber"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:letterSpacing="0.08"
        android:textColor="@color/mylibrary_ink"
        android:textSize="18sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/digitalCardBarcode"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:layout_marginTop="12dp"
        android:adjustViewBounds="true"
        android:contentDescription="Barcode thẻ thư viện"
        android:scaleType="fitCenter"
        android:background="@android:color/white"
        android:padding="6dp" />

    <TextView
        android:id="@+id/digitalCardIssueDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="@color/mylibrary_muted"
        android:textSize="12sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Đưa barcode này cho thủ thư khi làm thủ tục mượn hoặc trả sách."
        android:textColor="@color/mylibrary_ink"
        android:textSize="13sp" />
</LinearLayout>

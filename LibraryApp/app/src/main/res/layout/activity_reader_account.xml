<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:fitsSystemWindows="true" android:background="@color/mylibrary_cream">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="16dp" android:paddingBottom="12dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MyLibrary" android:textSize="24sp" android:textStyle="bold" android:textColor="@color/mylibrary_teal"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Tài khoản" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/mylibrary_ink"/>
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="18dp" android:paddingEnd="18dp" android:paddingBottom="20dp">
            
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Cập nhật thông tin độc giả của bạn." android:textColor="@color/mylibrary_muted" android:textSize="14sp" android:layout_marginBottom="16dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Họ và tên" android:textStyle="bold" android:textColor="@color/mylibrary_ink"/>
            <EditText android:id="@+id/editFullName" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="6dp" android:background="@drawable/bg_input" android:paddingStart="12dp" android:paddingEnd="12dp" android:singleLine="true" android:hint="Nhập họ tên" android:textColor="@color/mylibrary_ink"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Email đăng nhập" android:textStyle="bold" android:textColor="@color/mylibrary_ink"/>
            <TextView android:id="@+id/textAccountEmail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/mylibrary_ink" android:textSize="15sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Số điện thoại" android:textStyle="bold" android:textColor="@color/mylibrary_ink"/>
            <EditText android:id="@+id/editPhone" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="6dp" android:background="@drawable/bg_input" android:paddingStart="12dp" android:paddingEnd="12dp" android:hint="Nhập số điện thoại" android:inputType="phone" android:singleLine="true" android:textColor="@color/mylibrary_ink"/>
            <Button android:id="@+id/btnSaveProfile" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="20dp" android:text="Lưu thay đổi" android:textAllCaps="false" android:textColor="@color/white" android:backgroundTint="@color/mylibrary_teal"/>
            <Button android:id="@+id/btnChangePassword" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="10dp" android:text="Đổi mật khẩu" android:textAllCaps="false" android:textColor="@color/mylibrary_ink" android:backgroundTint="@color/mylibrary_cream"/>
            <Button android:id="@+id/btnDigitalLibraryCard" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:text="Thẻ thư viện số" android:textAllCaps="false" android:textColor="@color/white" android:backgroundTint="@color/mylibrary_teal"/>
            <Button android:id="@+id/btnAccountLogout" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="10dp" android:text="Đăng xuất" android:textAllCaps="false" android:textColor="@color/white" android:backgroundTint="@color/mylibrary_ink"/>
        </LinearLayout>
    </ScrollView>

    <LinearLayout android:layout_width="match_parent" android:layout_height="60dp" android:orientation="horizontal"
        android:gravity="center" android:background="@android:color/white" android:elevation="8dp" android:paddingStart="4dp" android:paddingEnd="4dp">
        <LinearLayout android:id="@+id/tabHome" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:clickable="true" android:focusable="true">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⌂" android:textSize="22sp" android:textColor="@color/mylibrary_muted"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Trang chủ" android:textSize="11sp" android:textColor="@color/mylibrary_muted"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/tabBorrowedBooks" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:clickable="true" android:focusable="true">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="▤" android:textSize="21sp" android:textColor="@color/mylibrary_muted"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Mượn sách" android:textSize="11sp" android:textColor="@color/mylibrary_muted"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/tabNotifications" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:clickable="true" android:focusable="true">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="♧" android:textSize="21sp" android:textColor="@color/mylibrary_muted"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Thông báo" android:textSize="11sp" android:textColor="@color/mylibrary_muted"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/tabAccount" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:clickable="true" android:focusable="true">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="●" android:textSize="18sp" android:textColor="@color/mylibrary_teal"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tài khoản" android:textSize="11sp" android:textColor="@color/mylibrary_teal"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mylibrary_cream"
    android:fillViewport="true">
    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="44dp"
        android:paddingBottom="28dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="230dp"
            android:background="#E9E0D1"
            android:gravity="center"
            android:text="▤"
            android:textColor="@color/mylibrary_teal"
            android:textSize="76sp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="▣  MyLibrary"
            android:textColor="@color/mylibrary_teal"
            android:textSize="30sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="Chào mừng bạn đến với Hệ thống Thư viện Hiện đại UEF"
            android:textColor="@color/mylibrary_muted"
            android:textSize="15sp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="▣   Kho sách điện tử đa dạng\n      Truy cập hàng ngàn đầu sách, tài liệu chuyên khảo mọi lúc mọi nơi."
            android:textColor="@color/mylibrary_ink"
            android:textSize="16sp"
            android:lineSpacingExtra="4dp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="▦   Mượn trả nhanh bằng QR\n      Không cần chờ đợi, quét mã tại các quầy tự phục vụ thông minh."
            android:textColor="@color/mylibrary_ink"
            android:textSize="16sp"
            android:lineSpacingExtra="4dp" />
        <Space
            android:layout_width="match_parent"
            android:layout_height="28dp" />
        <Button
            android:id="@+id/btnStart"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:backgroundTint="@color/mylibrary_teal"
            android:text="Bắt đầu ngay"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp" />
    </LinearLayout>
</ScrollView>
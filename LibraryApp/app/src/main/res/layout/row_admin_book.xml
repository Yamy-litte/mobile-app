<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:padding="12dp" android:background="@drawable/bg_book_card">
    <ImageView android:id="@+id/adminBookCover" android:layout_width="76dp" android:layout_height="100dp"
        android:scaleType="centerCrop" android:contentDescription="Ảnh bìa sách"
        android:src="@android:drawable/ic_menu_gallery"/>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:orientation="vertical" android:paddingStart="12dp" android:paddingEnd="4dp">
        <TextView android:id="@+id/adminBookTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Đất rừng phương Nam" android:textSize="16sp" android:textStyle="bold"
            android:textColor="@color/mylibrary_ink" android:maxLines="2" android:ellipsize="end"/>
        <TextView android:id="@+id/adminBookAuthor" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="3dp" android:text="Đoàn Giỏi" android:textSize="13sp"
            android:textColor="@color/mylibrary_muted" android:maxLines="1" android:ellipsize="end"/>
        <TextView android:id="@+id/adminBookIsbn" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:text="ISBN: Chưa cập nhật" android:textSize="11sp"
            android:textColor="@color/mylibrary_muted" android:maxLines="1"/>
        <TextView android:id="@+id/adminBookStock" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:text="Tổng: 5 | Còn: 3" android:textSize="12sp"
            android:textColor="@color/mylibrary_ink" android:textStyle="bold"/>
    </LinearLayout>
    <LinearLayout android:layout_width="34dp" android:layout_height="match_parent"
        android:orientation="vertical" android:gravity="center_horizontal">
        <TextView android:id="@+id/adminBookEdit" android:layout_width="36dp" android:layout_height="42dp"
            android:gravity="center" android:text="✎" android:textSize="25sp" android:textColor="@color/mylibrary_teal"
            android:contentDescription="Sửa sách" android:clickable="true" android:focusable="true"/>
        <TextView android:id="@+id/adminBookDelete" android:layout_width="36dp" android:layout_height="42dp"
            android:gravity="center" android:text="▤" android:textSize="24sp" android:textColor="@color/mylibrary_terracotta"
            android:contentDescription="Ẩn sách" android:clickable="true" android:focusable="true"/>
    </LinearLayout>
</LinearLayout>
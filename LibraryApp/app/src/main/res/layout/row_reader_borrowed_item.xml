<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@android:color/white">

    <TextView
        android:id="@+id/textBorrowedItemTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/mylibrary_ink"
        android:textSize="16sp"
        android:textStyle="bold"/>

    <TextView
        android:id="@+id/textBorrowedItemDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/mylibrary_muted"
        android:textSize="14sp"/>

    <Button
        android:id="@+id/btnCancelBorrowRequest"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Hủy yêu cầu"
        android:textAllCaps="false"
        android:visibility="gone"/>
</LinearLayout>
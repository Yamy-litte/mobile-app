<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/bg_reader_borrowed_card">

    <TextView
        android:id="@+id/textBorrowedItemTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/mylibrary_ink"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textBorrowedItemDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:lineSpacingExtra="3dp"
        android:textColor="@color/mylibrary_muted"
        android:textSize="14sp" />

    <ProgressBar
        android:id="@+id/progressBorrowingPeriod"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="12dp"
        android:max="100"
        android:progress="0"
        android:progressTint="@color/mylibrary_teal"
        android:progressBackgroundTint="#FFE7EAE7"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnRenewBorrow"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginEnd="8dp"
            android:backgroundTint="@color/mylibrary_teal"
            android:text="Gia hạn mượn"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnCancelBorrowRequest"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:backgroundTint="@color/mylibrary_soft_red"
            android:text="Hủy yêu cầu"
            android:textAllCaps="false"
            android:textColor="@color/mylibrary_terracotta"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="@color/mylibrary_cream">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp"
        android:text="Quét thẻ độc giả"
        android:textColor="@color/mylibrary_ink"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingTop="6dp"
        android:paddingEnd="20dp"
        android:text="Quét barcode Code 128 trên thẻ thư viện số để tìm hồ sơ và các phiếu mượn đang hoạt động."
        android:textColor="@color/mylibrary_muted"
        android:textSize="14sp" />

    <Button
        android:id="@+id/btnStartCardScan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="20dp"
        android:text="Mở máy quét barcode"
        android:textAllCaps="false"
        android:backgroundTint="@color/mylibrary_teal"
        android:textColor="@android:color/white" />

    <TextView
        android:id="@+id/textScanStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="8dp"
        android:text="Chưa quét thẻ."
        android:textColor="@color/mylibrary_teal"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textScannedReader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:padding="14dp"
        android:background="@android:color/white"
        android:text="Thông tin độc giả sẽ xuất hiện tại đây sau khi quét thẻ."
        android:textColor="@color/mylibrary_ink"
        android:textSize="14sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingTop="14dp"
        android:paddingEnd="20dp"
        android:paddingBottom="6dp"
        android:text="Sách đang mượn"
        android:textColor="@color/mylibrary_ink"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textReaderLoansEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="18dp"
        android:text="Chưa có dữ liệu phiếu mượn."
        android:textColor="@color/mylibrary_muted"
        android:visibility="gone" />

    <ListView
        android:id="@+id/listReaderActiveLoans"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:divider="@android:color/transparent"
        android:dividerHeight="8dp"
        android:clipToPadding="false" />

    <Button
        android:id="@+id/btnScanBackHome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="8dp"
        android:text="Quay lại"
        android:textAllCaps="false" />

    <LinearLayout
        android:id="@+id/adminBottomBar"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@android:color/white"
        android:elevation="10dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">
        <LinearLayout android:id="@+id/adminTabHome" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:clickable="true" android:focusable="true">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⌂" android:textSize="27sp" android:textColor="@color/mylibrary_muted"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Trang chủ" android:textSize="12sp" android:textColor="@color/mylibrary_muted"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/adminTabBooks" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:clickable="true" android:focusable="true">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="▤" android:textSize="27sp" android:textColor="@color/mylibrary_muted"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Kho sách" android:textSize="12sp" android:textColor="@color/mylibrary_muted"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/adminTabScan" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:clickable="true" android:focusable="true">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="▦" android:textSize="27sp" android:textColor="@color/mylibrary_teal"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Quét mã" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/mylibrary_teal"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/adminTabLoans" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:clickable="true" android:focusable="true">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="▣" android:textSize="27sp" android:textColor="@color/mylibrary_muted"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Phiếu mượn" android:textSize="12sp" android:textColor="@color/mylibrary_muted"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/adminTabAccount" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:clickable="true" android:focusable="true">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="♙" android:textSize="27sp" android:textColor="@color/mylibrary_muted"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tài khoản" android:textSize="12sp" android:textColor="@color/mylibrary_muted"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
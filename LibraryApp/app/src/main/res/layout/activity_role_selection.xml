<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="24dp" android:background="@color/mylibrary_cream">
    <TextView android:id="@+id/btnBack" android:layout_width="match_parent" android:layout_height="48dp"
        android:text="‹                         Đăng nhập" android:textSize="20sp" android:textStyle="bold"
        android:gravity="center_vertical" android:textColor="@color/mylibrary_ink" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp"
        android:text="Chọn vai trò của bạn" android:textSize="28sp" android:textStyle="bold" android:textColor="@color/mylibrary_teal"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
        android:text="Vui lòng xác định tài khoản đăng nhập để hệ thống hiển thị đúng tính năng tương ứng."
        android:textSize="15sp" android:textColor="@color/mylibrary_muted"/>
    <RadioGroup android:id="@+id/roleGroup" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:layout_marginTop="26dp">
        <RadioButton android:id="@+id/radioReader" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="94dp" android:padding="16dp" android:checked="true" android:text="Độc giả&#10;Sinh viên, giảng viên mượn sách &amp; tài liệu học tập"
            android:textSize="16sp" android:textColor="@color/mylibrary_ink" android:buttonTint="@color/mylibrary_teal" android:background="@drawable/bg_role_option"/>
        <RadioButton android:id="@+id/radioAdmin" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="94dp" android:padding="16dp" android:layout_marginTop="14dp"
            android:text="Admin&#10;Quản lý kho sách, mượn trả, duyệt đặt trước, độc giả và báo cáo"
            android:textSize="16sp" android:textColor="@color/mylibrary_ink" android:buttonTint="@color/mylibrary_teal" android:background="@drawable/bg_role_option"/>
    </RadioGroup>
    <Space android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
    <Button android:id="@+id/btnContinue" android:layout_width="match_parent" android:layout_height="54dp"
        android:text="Tiếp tục" android:textAllCaps="false" android:textColor="@color/white" android:backgroundTint="@color/mylibrary_teal"/>
</LinearLayout>
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="@color/mylibrary_cream">
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="18dp"
        android:text="Yêu cầu mượn nhiều sách"
        android:textColor="@color/mylibrary_ink"
        android:textSize="22sp"
        android:textStyle="bold"/>
    <TextView
        android:id="@+id/textSelectedBooksCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:text="Đã chọn 0 cuốn sách"
        android:textColor="@color/mylibrary_muted"/>
    <Button
        android:id="@+id/btnPickupDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:text="Ngày nhận"
        android:textAllCaps="false"
        android:backgroundTint="@color/mylibrary_teal"
        android:textColor="@color/white"/>
    <Button
        android:id="@+id/btnDueDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:text="Ngày trả"
        android:textAllCaps="false"
        android:backgroundTint="@color/mylibrary_teal"
        android:textColor="@color/white"/>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="4dp"
        android:text="Chọn sách còn tồn kho"
        android:textColor="@color/mylibrary_ink"
        android:textStyle="bold"/>
    <ListView
        android:id="@+id/listMultiBookSelection"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:choiceMode="multipleChoice"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:dividerHeight="1dp"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">
        <Button
            android:id="@+id/btnCancelMultiBookRequest"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="Hủy"
            android:textAllCaps="false"/>
        <Button
            android:id="@+id/btnSubmitMultiBookRequest"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="Gửi yêu cầu"
            android:textAllCaps="false"
            android:backgroundTint="@color/mylibrary_teal"
            android:textColor="@color/white"/>
    </LinearLayout>
</LinearLayout>

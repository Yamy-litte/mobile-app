<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:fitsSystemWindows="true"
    android:background="@color/mylibrary_cream">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingStart="24dp" android:paddingEnd="24dp"
        android:paddingTop="16dp" android:paddingBottom="8dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Quản lý kho sách" android:textSize="26sp" android:textStyle="bold"
            android:textColor="@color/mylibrary_ink" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="3dp" android:text="Tìm kiếm, chỉnh sửa và cập nhật kho sách"
            android:textSize="14sp" android:textColor="@color/mylibrary_muted" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="50dp"
            android:layout_marginTop="14dp" android:orientation="horizontal" android:gravity="center_vertical"
            android:background="@drawable/bg_input" android:paddingStart="14dp" android:paddingEnd="14dp">
            <TextView android:layout_width="28dp" android:layout_height="wrap_content" android:text="⌕"
                android:textSize="26sp" android:textColor="@color/mylibrary_muted" />
            <EditText android:id="@+id/editAdminBookSearch" android:layout_width="0dp"
                android:layout_height="match_parent" android:layout_weight="1" android:background="@android:color/transparent"
                android:hint="Tìm kiếm sách, tác giả, ISBN..." android:singleLine="true"
                android:inputType="text" android:textColor="@color/mylibrary_ink" android:textSize="15sp"
                android:paddingStart="4dp" android:paddingEnd="4dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="☷" android:textSize="23sp" android:textColor="@color/mylibrary_teal"/>
        </LinearLayout>
        <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:scrollbars="none">
            <LinearLayout android:id="@+id/categoryFilterContainer" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:id="@+id/filterAll" android:layout_width="wrap_content" android:layout_height="38dp"
                    android:gravity="center" android:paddingStart="18dp" android:paddingEnd="18dp"
                    android:text="Tất cả" android:textStyle="bold" android:textColor="@android:color/white"
                    android:background="@drawable/bg_filter_selected"/>
                <TextView android:id="@+id/filterLiterature" android:layout_width="wrap_content" android:layout_height="38dp"
                    android:layout_marginStart="8dp" android:gravity="center" android:paddingStart="18dp" android:paddingEnd="18dp"
                    android:text="Văn học" android:textColor="@color/mylibrary_ink" android:background="@drawable/bg_filter_chip"/>
                <TextView android:id="@+id/filterScience" android:layout_width="wrap_content" android:layout_height="38dp"
                    android:layout_marginStart="8dp" android:gravity="center" android:paddingStart="18dp" android:paddingEnd="18dp"
                    android:text="Khoa học" android:textColor="@color/mylibrary_ink" android:background="@drawable/bg_filter_chip"/>
                <TextView android:id="@+id/filterHistory" android:layout_width="wrap_content" android:layout_height="38dp"
                    android:layout_marginStart="8dp" android:gravity="center" android:paddingStart="18dp" android:paddingEnd="18dp"
                    android:text="Lịch sử" android:textColor="@color/mylibrary_ink" android:background="@drawable/bg_filter_chip"/>
                <TextView android:id="@+id/filterEconomy" android:layout_width="wrap_content" android:layout_height="38dp"
                    android:layout_marginStart="8dp" android:gravity="center" android:paddingStart="18dp" android:paddingEnd="18dp"
                    android:text="Kinh tế" android:textColor="@color/mylibrary_ink" android:background="@drawable/bg_filter_chip"/>
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>
    <TextView android:id="@+id/textAdminBookCount" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingStart="24dp" android:paddingEnd="24dp" android:paddingTop="2dp" android:paddingBottom="7dp"
        android:text="0 sách" android:textColor="@color/mylibrary_muted" android:textSize="12sp" android:visibility="gone"/>
    <TextView android:id="@+id/textAdminBooksEmpty" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center" android:padding="24dp" android:text="Chưa có sách phù hợp."
        android:textColor="@color/mylibrary_muted" android:visibility="gone"/>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <ListView android:id="@+id/listAdminBooks" android:layout_width="match_parent" android:layout_height="match_parent"
            android:paddingStart="22dp" android:paddingEnd="22dp" android:paddingTop="2dp" android:paddingBottom="12dp"
            android:divider="@android:color/transparent" android:dividerHeight="10dp"
            android:clipToPadding="false" android:background="@color/mylibrary_cream"/>
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnAddBook" android:layout_width="58dp" android:layout_height="58dp"
            android:layout_gravity="bottom|end" android:layout_marginEnd="26dp" android:layout_marginBottom="18dp"
            android:contentDescription="Thêm sách" android:src="@android:drawable/ic_input_add"
            android:tint="@android:color/white" app:backgroundTint="@color/mylibrary_terracotta"
            xmlns:app="http://schemas.android.com/apk/res-auto"/>
    </FrameLayout>
    <LinearLayout android:id="@+id/adminBottomBar" android:layout_width="match_parent" android:layout_height="66dp"
        android:orientation="horizontal" android:gravity="center" android:background="@android:color/white"
        android:elevation="10dp" android:paddingStart="3dp" android:paddingEnd="3dp">
        <LinearLayout android:id="@+id/adminTabHome" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:clickable="true" android:focusable="true">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⌂" android:textSize="25sp" android:textColor="@color/mylibrary_muted"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Trang chủ" android:textSize="11sp" android:textColor="@color/mylibrary_muted"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/adminTabBooks" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="▤" android:textSize="25sp" android:textColor="@color/mylibrary_teal"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Kho sách" android:textSize="11sp" android:textStyle="bold" android:textColor="@color/mylibrary_teal"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/adminTabScan" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:clickable="true" android:focusable="true">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="▦" android:textSize="25sp" android:textColor="@color/mylibrary_muted"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Mượn trả" android:textSize="11sp" android:textColor="@color/mylibrary_muted"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/adminTabLoans" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:clickable="true" android:focusable="true">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="▣" android:textSize="25sp" android:textColor="@color/mylibrary_muted"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Quản lý" android:textSize="11sp" android:textColor="@color/mylibrary_muted"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/adminTabAccount" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:clickable="true" android:focusable="true">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="♙" android:textSize="25sp" android:textColor="@color/mylibrary_muted"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tài khoản" android:textSize="11sp" android:textColor="@color/mylibrary_muted"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
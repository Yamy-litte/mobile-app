<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/coffee_cream"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Xác nhận đơn hàng"
            android:textColor="@color/coffee_dark"
            android:textSize="25sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/checkoutSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_hero_card"
            android:padding="16dp"
            android:text="Chi tiết đơn hàng"
            android:textColor="@color/coffee_text"
            android:textSize="16sp" />
        <Button
            android:id="@+id/placeOrderButton"
            style="@style/CoffeePrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Xác nhận đặt hàng" />
        <Button
            android:id="@+id/backToCartButton"
            style="@style/CoffeeSecondaryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Quay lại giỏ hàng" />
    </LinearLayout>
</ScrollView>
<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF7F2"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Café Booking Online"
            android:textColor="#744B30"
            android:textSize="26sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Module 1 · Kiểm tra cơ sở dữ liệu"
            android:textColor="#302720"
            android:textSize="16sp"
            android:gravity="center" />

        <TextView
            android:id="@+id/databaseStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:padding="20dp"
            android:background="#FFFFFF"
            android:text="Đang kiểm tra SQLite..."
            android:textColor="#302720"
            android:textSize="16sp"
            android:lineSpacingExtra="6dp" />

    </LinearLayout>
</ScrollView>

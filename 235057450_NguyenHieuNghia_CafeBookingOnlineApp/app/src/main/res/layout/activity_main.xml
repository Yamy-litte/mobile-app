<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FAF7F2"
    android:paddingStart="18dp"
    android:paddingEnd="18dp"
    android:paddingTop="18dp"
    android:paddingBottom="8dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="CAFÉ MENU"
        android:textColor="#744B30"
        android:textSize="13sp"
        android:textStyle="bold"
        android:letterSpacing="0.12"
        android:paddingBottom="4dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="What would you like today?"
        android:textColor="#302720"
        android:textSize="25sp"
        android:textStyle="bold"
        android:paddingBottom="14dp" />

    <TextView
        android:id="@+id/cartButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center"
        android:text="🛒 Cart (0)  •  0 ₫"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        android:background="#744B30"
        android:padding="10dp"
        android:layout_marginBottom="18dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Categories"
        android:textColor="#302720"
        android:textSize="18sp"
        android:textStyle="bold"
        android:paddingBottom="10dp" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:fillViewport="false"
        android:scrollbars="none"
        android:layout_marginBottom="18dp">

        <LinearLayout
            android:id="@+id/categoryContainer"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical" />
    </HorizontalScrollView>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Drinks &amp; treats"
        android:textColor="#302720"
        android:textSize="18sp"
        android:textStyle="bold"
        android:paddingBottom="10dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:scrollbars="vertical">

        <LinearLayout
            android:id="@+id/menuContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="12dp" />
    </ScrollView>

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:background="@drawable/bg_input"
    android:orientation="vertical"
    android:padding="14dp">
    <TextView
        android:id="@+id/orderInfoText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/coffee_text"
        android:textSize="16sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/orderDetailsText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/coffee_muted"
        android:textSize="14sp" />
    <Button
        android:id="@+id/viewOrderDetailsButton"
        style="@style/CoffeePrimaryButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Xem chi tiết" />
    <Button
        android:id="@+id/cancelOrderButton"
        style="@style/CoffeeSecondaryButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Hủy đơn hàng"
        android:visibility="gone" />
</LinearLayout>